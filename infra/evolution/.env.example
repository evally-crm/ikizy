# copie para .env (fora do git) e preencha. Gere segredos com: openssl rand -hex 32

# domínio que aponta para o IP da VPS (registro A), ex.: evo.ikizy.com
EVOLUTION_DOMAIN=evo.ikizy.com

# chave da Evolution: a MESMA vai na Vercel como EVOLUTION_API_KEY
EVOLUTION_API_KEY=

# banco "evolution" no Neon, conexão DIRETA (host sem "-pooler"), ex.:
# postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/evolution?sslmode=require
EVOLUTION_DATABASE_URL=

# o MESMO valor de CRON_SECRET configurado na Vercel
CRON_SECRET=
APP_URL=https://app.ikizy.com
