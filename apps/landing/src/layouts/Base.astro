---
import '@fontsource-variable/outfit'
import '@fontsource/instrument-serif/400-italic.css'
import '@fontsource/geist-pixel/400.css'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { TAGLINE, CONTACT_EMAIL, LINKS } from '../lib/site'

interface Props {
  title: string
  description?: string
  /** dados estruturados extras da página (ex.: FAQPage) */
  schema?: Record<string, unknown>[]
  noindex?: boolean
}

const { title, description = TAGLINE, schema = [], noindex = false } = Astro.props
const isHome = title === 'IKIZY'
const fullTitle = isHome ? 'IKIZY — sistema de gestão para salões e negócios de beleza' : `${title} · IKIZY`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og.png', Astro.site)

const organization = {
  '@type': 'Organization',
  '@id': `${Astro.site}#organization`,
  name: 'IKIZY',
  url: String(Astro.site),
  logo: String(new URL('/apple-touch-icon.png', Astro.site)),
  email: CONTACT_EMAIL,
}
const graph = [
  organization,
  {
    '@type': 'WebSite',
    '@id': `${Astro.site}#website`,
    url: String(Astro.site),
    name: 'IKIZY',
    inLanguage: 'pt-BR',
    publisher: { '@id': organization['@id'] },
  },
  ...(isHome
    ? [
        {
          '@type': 'SoftwareApplication',
          name: 'IKIZY',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web',
          inLanguage: 'pt-BR',
          description,
          url: String(Astro.site),
          publisher: { '@id': organization['@id'] },
        },
      ]
    : []),
  ...schema,
]
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e0d0d" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IKIZY" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="IKIZY — gestão simples para negócios de beleza" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class={isHome ? 'is-home' : undefined}>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <div class="announce"><a href={LINKS.signup}>Crie sua conta e teste a IKIZY</a></div>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
