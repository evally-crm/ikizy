---
/**
 * coelho da marca em símbolos, no mesmo estilo do rosto do login (o desenho está em lib/pixelArt.ts).
 * usa a cor do texto; `step` é o tamanho da célula em px; `accent` pinta a boca de outra cor;
 * `soft` deixa o coelho mais abstrato, com a borda bem esfumada.
 */
interface Props {
  class?: string
  step?: number
  accent?: string
  soft?: boolean
}

const { class: className, step = 4, accent, soft = false } = Astro.props
---

<canvas
  class:list={['pixel-bunny', className]}
  aria-hidden="true"
  data-pixel-bunny
  data-step={step}
  data-accent={accent}
  data-soft={soft ? '' : undefined}
></canvas>

<script>
  import { animate, bunnyField, paintField } from '../lib/pixelArt'

  document.querySelectorAll<HTMLCanvasElement>('[data-pixel-bunny]').forEach((canvas) => {
    const step = Number(canvas.dataset.step) || 4
    const accent = canvas.dataset.accent
    const soft = 'soft' in canvas.dataset
    animate(canvas, (ctx, f) => {
      const frame = { ...f, step }
      paintField(ctx, bunnyField(frame, { accent: !!accent, soft }), frame, getComputedStyle(canvas).color, accent)
    })
  })
</script>
