---
/**
 * boca em símbolos (ponto, +, x, quadrado), aberta e com bordas esfumadas, se mexendo.
 * usa a cor do texto; `step` é o tamanho da célula em px (7 no grande, 4 no canhoto do ticket).
 */
interface Props {
  class?: string
  step?: number
}

const { class: className, step = 7 } = Astro.props
---

<canvas class:list={['pixel-mouth', className]} aria-hidden="true" data-pixel-mouth data-step={step}></canvas>

<script>
  const smooth = (a: number, b: number, x: number) => {
    const k = Math.min(1, Math.max(0, (x - a) / (b - a)))
    return k * k * (3 - 2 * k)
  }
  const bell = (x: number, w: number) => Math.exp(-((x / w) ** 2))
  const hash = (c: number, r: number) => {
    const s = Math.sin(c * 12.9898 + r * 78.233) * 43758.5453
    return s - Math.floor(s)
  }

  // contornos arredondados em u ∈ [-1, 1]: oval com um leve arco do cupido, e a abertura no meio onde fica a marca
  const top = (u: number) => -0.56 * Math.pow(1 - u * u, 0.6) + 0.11 * bell(u, 0.14)
  const bottom = (u: number) => 0.58 * Math.pow(1 - u * u, 0.55)
  const OPEN_W = 0.52
  const opening = (u: number, t: number) => Math.sqrt(Math.max(0, 1 - (u / OPEN_W) ** 2)) * (1 + Math.sin(t * 0.7) * 0.06)

  /** densidade (0..1) da boca: cheia no meio dos lábios, esfumando perto da borda e da abertura */
  function density(u: number, v: number, t: number) {
    if (Math.abs(u) >= 1) return 0
    const o = opening(u, t)
    const ui = -0.12 * o
    const li = 0.14 * o
    const tp = top(u)
    const bt = bottom(u)
    if (v < tp - 0.14 || v > bt + 0.14) return 0
    if (v > ui && v < li) return 0
    // distância (em u) até a borda mais próxima: de fora ou da abertura
    const out = Math.min(v - tp, bt - v)
    const inner = v <= ui ? ui - v : v - li
    const lipLine = Math.abs(v) < 0.03 && o === 0 ? 0.35 : 0 // fenda entre os lábios perto dos cantos
    return Math.max(0, smooth(-0.08, 0.26, out) * smooth(-0.01, 0.14, inner) - lipLine)
  }

  /** símbolo conforme a densidade, como no login: nada · ponto · + · x · quadradinho · quadrado */
  function glyph(ctx: CanvasRenderingContext2D, x: number, y: number, cell: number, d: number, mix: number) {
    const m = cell / 2
    const a = cell * 0.3
    const dot = cell * 0.13
    if (d < 0.1) return
    if (d >= 0.56 && mix < 0.3) d = 0.5
    if (d < 0.24) return ctx.fillRect(x + m - dot, y + m - dot, dot * 2, dot * 2)
    ctx.beginPath()
    if (d < 0.4) {
      ctx.moveTo(x + m, y + m - a)
      ctx.lineTo(x + m, y + m + a)
      ctx.moveTo(x + m - a, y + m)
      ctx.lineTo(x + m + a, y + m)
      return ctx.stroke()
    }
    if (d < 0.56) {
      ctx.moveTo(x + m - a * 0.9, y + m - a * 0.9)
      ctx.lineTo(x + m + a * 0.9, y + m + a * 0.9)
      ctx.moveTo(x + m + a * 0.9, y + m - a * 0.9)
      ctx.lineTo(x + m - a * 0.9, y + m + a * 0.9)
      return ctx.stroke()
    }
    if (d < 0.72) return ctx.fillRect(x + m - a, y + m - a, a * 2, a * 2)
    const g = cell / 7
    ctx.fillRect(x + g, y + g, cell - 2 * g, cell - 2 * g)
  }

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')
    if (!ctx) return
    const STEP = Number(canvas.dataset.step) || 7
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let visible = true
    let last = 0

    const draw = (t: number) => {
      const dpr = Math.min(devicePixelRatio || 1, 2)
      const { width, height } = canvas.getBoundingClientRect()
      if (!width || !height) return
      const w = Math.round(width * dpr)
      const h = Math.round(height * dpr)
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w
        canvas.height = h
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.clearRect(0, 0, width, height)

      const S = Math.min(width * 0.46, height * 0.66)
      const cx = width / 2
      const cy = height / 2
      // ondas na mesma escala do desenho, em qualquer tamanho
      const k = 7 / STEP
      const waveAt = (x: number, y: number) =>
        (Math.sin(x * 0.012 * k + Math.sin(y * 0.009 * k + t * 0.6) * 2.4 + t) +
          Math.sin(y * 0.014 * k - x * 0.007 * k + 1.7 - t * 0.8) * 0.8 +
          1.8) /
        3.6

      ctx.lineWidth = STEP * 0.19
      ctx.fillStyle = ctx.strokeStyle = getComputedStyle(canvas).color
      for (let row = 0, y = STEP / 2; y < height; row++, y += STEP) {
        for (let col = 0, x = STEP / 2; x < width; col++, x += STEP) {
          const u = (x - cx) / S + Math.sin(y * 0.02 * k + t * 0.8) * 0.01
          const v = (y - cy) / S + Math.sin(x * 0.017 * k - t * 0.6) * 0.01
          const n = hash(row, col)
          const wave = waveAt(x, y)
          let d = density(u, v, t)
          if (d <= 0.02) {
            // pontinhos e + soltos em volta, como pó
            const e = Math.hypot(u / 1.12, v / 0.78)
            const inMouth = Math.abs(u) < OPEN_W + 0.06 && Math.abs(v) < 0.2
            if (!inMouth && e < 1.2 && n < smooth(1.2, 0.85, e) * 0.45 * wave) d = 0.15 + n * 0.4
            else continue
          } else {
            // volume dos lábios: mais escuro junto à abertura, brilho no lábio de baixo, e ondas que fazem os símbolos irem e voltarem
            const gloss = bell(u - 0.12, 0.25) * bell(v - 0.36, 0.08) * 0.45
            const rim = bell(Math.abs(v) - 0.16, 0.06) * 0.2
            d = d * (0.84 + 0.16 * wave) + rim - gloss
          }
          glyph(ctx, x - STEP / 2, y - STEP / 2, STEP, d + (n - 0.5) * 0.14, hash(col, row))
        }
      }
    }

    if (still) {
      draw(0)
      new ResizeObserver(() => draw(0)).observe(canvas)
      return
    }
    new IntersectionObserver((e) => (visible = e[0].isIntersecting)).observe(canvas)
    const tick = (now: number) => {
      if (visible && now - last >= 1000 / 30) {
        last = now
        draw(now / 1000)
      }
      requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-pixel-mouth]').forEach(start)
</script>
