---
/**
 * flor em símbolos, no mesmo nível de detalhe da boca do início: ponto · + · x · quadradinho · quadrado
 * conforme a densidade, cheia no miolo e nas pétalas, esfumando nas bordas, com pó solto em volta.
 * gerada no build (sem animação), então sai sempre igual e fica nítida em qualquer tela.
 */
interface Props {
  class?: string
}

const { class: className } = Astro.props

const N = 36 // células por lado
const STEP = 7 // tamanho da célula, igual ao da boca
const PETALS = 5
const c = (N - 1) / 2

const smooth = (a: number, b: number, x: number) => {
  const k = Math.min(1, Math.max(0, (x - a) / (b - a)))
  return k * k * (3 - 2 * k)
}
const hash = (a: number, b: number) => {
  const s = Math.sin(a * 12.9898 + b * 78.233) * 43758.5453
  return s - Math.floor(s)
}

/** densidade (0..1) da flor: cinco pétalas arredondadas com uma leve curva, cheias no meio e esfumadas na borda */
function density(dx: number, dy: number) {
  const r = Math.hypot(dx, dy)
  const a = Math.atan2(dy, dx) + 0.3 + 0.35 * r
  const petal = 0.15 + 0.85 * Math.pow(Math.abs(Math.cos((PETALS / 2) * a)), 1.3)
  const edge = r / petal
  const body = smooth(1.35, 0.25, edge)
  const core = smooth(0.2, 0.04, r) * 0.9
  // nervura mais clara no meio de cada pétala
  const vein = Math.pow(Math.abs(Math.cos((PETALS / 2) * a)), 40) * smooth(0.15, 0.4, r) * 0.25
  return Math.min(1, Math.max(body - vein, core))
}

const m = STEP / 2
const g = STEP * 0.3
const squares: string[] = []
const strokes: string[] = []

for (let row = 0; row < N; row++) {
  for (let col = 0; col < N; col++) {
    const x = col * STEP
    const y = row * STEP
    const dx = (col - c) / c
    const dy = (row - c) / c
    const n = hash(row, col)
    let d = density(dx, dy)
    if (d <= 0.03) {
      // pó solto em volta, como na boca
      const r = Math.hypot(dx, dy)
      if (r < 1.4 && n < smooth(1.4, 0.6, r) * 0.45) d = 0.12 + n * 0.35
      else continue
    }
    d += (n - 0.5) * 0.3
    if (d >= 0.56 && hash(col, row) < 0.45) d = 0.5
    if (d < 0.1) continue
    if (d < 0.24) squares.push(`M${x + m - 0.9} ${y + m - 0.9}h1.8v1.8h-1.8z`)
    else if (d < 0.4) strokes.push(`M${x + m} ${y + m - g}v${2 * g}M${x + m - g} ${y + m}h${2 * g}`)
    else if (d < 0.56) {
      const k = g * 0.9
      strokes.push(`M${x + m - k} ${y + m - k}l${2 * k} ${2 * k}M${x + m + k} ${y + m - k}l${-2 * k} ${2 * k}`)
    } else if (d < 0.72) squares.push(`M${x + m - g} ${y + m - g}h${2 * g}v${2 * g}h${-2 * g}z`)
    else squares.push(`M${x + 1} ${y + 1}h${STEP - 2}v${STEP - 2}h${-(STEP - 2)}z`)
  }
}

const size = N * STEP
---

<svg class={className} viewBox={`0 0 ${size} ${size}`} aria-hidden="true">
  <path d={squares.join('')} fill="currentColor" />
  <path d={strokes.join('')} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
</svg>
