---
import Base from '../layouts/Base.astro'
import { LINKS } from '../lib/site'
---

<Base title="Página não encontrada" description="A página que você procura não existe ou mudou de endereço." noindex>
  <section class="container page-head">
    <p class="eyebrow">Erro 404</p>
    <h1 class="h1" style="margin-top: 10px;">Essa página <em>não existe</em>.</h1>
    <p class="lead">O endereço pode ter mudado ou estar digitado errado. Volte ao início ou comece a usar a IKIZY.</p>
    <div class="btn-row" style="margin-top: 28px;">
      <a class="btn btn--primary" href="/">Ir para o início</a>
      <a class="btn btn--ghost" href={LINKS.signup}>Teste agora</a>
    </div>
  </section>
</Base>
