---
import Base from '../layouts/Base.astro'
import { CONTACT_EMAIL, LINKS } from '../lib/site'
import { PIX_DISCOUNT_PCT, PIX_MONTHS, PLANS, brlNumber } from '../lib/pricing'

const crafts = [
  { name: 'Cabeleireira', hint: 'Agenda por profissional' },
  { name: 'Nail Designer', hint: 'Serviços e custo por produto' },
  { name: 'Lash Design', hint: 'Retorno e manutenção' },
  { name: 'Sobrancelha', hint: 'Fidelidade e lembretes' },
]

const ticker = ['Agenda online', 'Clientes que voltam', 'Financeiro descomplicado', 'Site do seu negócio', 'Comissões da equipe', 'Lembretes por WhatsApp', 'Relatórios']

const floaters = [
  { x: 4, y: 12, r: -8, w: 92, h: 112, tone: 'rose' },
  { x: 15, y: 54, r: 6, w: 84, h: 84, tone: 'wine', label: 'Unhas em gel' },
  { x: 8, y: 80, r: -4, w: 70, h: 70, tone: 'blush' },
  { x: 25, y: 20, r: 10, w: 64, h: 78, tone: 'wine' },
  { x: 33, y: 6, r: -6, w: 58, h: 58, tone: 'rose', label: '14:30' },
  { x: 36, y: 82, r: 8, w: 76, h: 56, tone: 'sand' },
  { x: 62, y: 8, r: 7, w: 70, h: 70, tone: 'sand' },
  { x: 70, y: 84, r: -9, w: 62, h: 80, tone: 'rose' },
  { x: 76, y: 18, r: -5, w: 96, h: 74, tone: 'blush', label: 'Confirmado' },
  { x: 88, y: 6, r: 9, w: 66, h: 66, tone: 'wine' },
  { x: 86, y: 44, r: -7, w: 90, h: 112, tone: 'rose' },
  { x: 92, y: 74, r: 6, w: 70, h: 70, tone: 'sand', label: 'Lash design' },
  { x: 76, y: 60, r: 4, w: 56, h: 56, tone: 'wine' },
  { x: 22, y: 36, r: -10, w: 52, h: 52, tone: 'blush' },
]

const chips = [
  { t: 'Cliente esqueceu o horário', x: 6, y: 14, d: 0, hot: true },
  { t: 'Caixa no caderno', x: 70, y: 8, d: -2 },
  { t: 'Planilha desatualizada', x: 80, y: 46, d: -4, hot: true },
  { t: 'Mensagens perdidas no WhatsApp', x: 4, y: 62, d: -1 },
  { t: 'Sem saber o lucro do mês', x: 60, y: 82, d: -5 },
  { t: 'Comissão na calculadora', x: 22, y: 86, d: -3 },
]

const pains = [
  { was: 'Cliente esqueceu o horário', title: 'Lembrete automático', text: 'Confirmação e lembrete por WhatsApp antes do horário, para reduzir faltas.' },
  { was: 'Caixa no caderno', title: 'Financeiro em um lugar', text: 'Entradas, saídas e formas de pagamento. O fechamento do mês sai como um recibo.' },
  { was: 'Cliente que sumiu', title: 'Aviso de retorno', text: 'O sistema mostra quem está atrasada para voltar, para você chamar de volta.' },
  { was: 'Comissão na calculadora', title: 'Comissão por profissional', text: 'Percentuais por profissional e valores calculados sem planilha.' },
]

const reasons = [
  { n: '01', title: 'Simples de verdade', text: 'Sem curso e sem manual. Você abre, cadastra seus serviços e já começa a agendar.' },
  { n: '02', title: 'Feito para beleza', text: 'Retorno de clientes, comissão por profissional e custo por serviço, do jeito que o seu dia funciona.' },
  { n: '03', title: 'Funciona no celular', text: 'No navegador, sem instalar nada. Sua agenda e seu caixa no bolso, dentro e fora do salão.' },
  { n: '04', title: 'Seus dados protegidos', text: 'Cada negócio enxerga só o que é seu, e a equipe acessa conforme o papel de cada pessoa.' },
]

const steps = [
  { title: 'Crie sua conta', text: 'Informe o nome do seu negócio e o tipo de atendimento. Leva poucos minutos.' },
  { title: 'Cadastre serviços e equipe', text: 'Valores, duração e profissionais. O sistema já sugere o básico do seu segmento.' },
  { title: 'Agende e acompanhe', text: 'Divulgue o endereço do seu site e acompanhe agenda, clientes e caixa em um só lugar.' },
]

const faq = [
  { q: 'O que é a IKIZY?', a: 'A IKIZY é um sistema de gestão online para salões e negócios de beleza. Reúne agenda, cadastro de clientes, financeiro, equipe e um site próprio para receber agendamentos.' },
  { q: 'Para quem a IKIZY é indicada?', a: 'Para cabeleireiras, nail designers, profissionais de cílios e sobrancelhas, studios e salões, de quem atende sozinha a quem tem equipe.' },
  { q: 'Preciso instalar alguma coisa?', a: 'Não. A IKIZY funciona direto no navegador, no computador ou no celular.' },
  { q: 'Posso testar antes de assinar?', a: 'Sim. O plano Solo tem 1 mês grátis, sem pedir cartão. Crie sua conta e use o sistema durante o teste antes de decidir.' },
  { q: 'Como posso pagar?', a: 'No cartão de crédito, com renovação automática todo mês, ou no Pix, pagando 1, 3 ou 12 meses adiantado, sendo que 12 meses têm 5% de desconto. O Pix não renova sozinho: avisamos antes de o período acabar.' },
  { q: 'O que acontece quando o teste ou o período pago termina?', a: 'O sistema fica só para leitura: seus dados continuam salvos e você pode consultá-los. Ao escolher um plano, tudo volta a funcionar.' },
  { q: 'Meus dados ficam separados dos de outros negócios?', a: 'Sim. Cada negócio enxerga apenas os próprios dados, e o acesso da equipe é controlado por papéis: dona, gerente, recepção e profissional.' },
]

const extras = ['Equipe e comissões', 'Serviços e custos', 'Relatórios', 'Lembretes por WhatsApp', 'Acesso por papel: dona, gerente, recepção e profissional']

const values = [
  { title: 'Estética', text: 'Um sistema bonito de usar importa. Quem trabalha com beleza merece ferramentas à altura.' },
  { title: 'Elegância', text: 'Telas limpas, sem excesso. Cada informação aparece quando você precisa dela.' },
  { title: 'Autenticidade', text: 'Seu negócio tem identidade própria. A IKIZY ajuda a mostrar isso, em vez de padronizar.' },
]

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<Base
  title="IKIZY"
  description="Agenda online, clientes, financeiro e site próprio em um só sistema. Gestão simples para salões, nail designers, lash e sobrancelha. Teste agora."
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="hero2" aria-label="Apresentação">
    <div class="hero2__grid">
      <div class="hero2__text">
        <h1 class="display">
          <span class="display__main"><span>Gestão</span><i class="display__line" aria-hidden="true"></i><em>simples</em></span>
          <span class="display__sub">para negócios de beleza</span>
        </h1>
        <p class="hero2__note">
          Agenda, clientes, financeiro e um site com o endereço do seu negócio, tudo em um sistema simples de usar.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={LINKS.signup}>Teste agora</a>
          <a class="btn btn--ghost" href="#recursos">Ver recursos</a>
        </div>
      </div>

      <div class="art" aria-hidden="true">
        <canvas id="halftone"></canvas>
        <span class="art__mark">ikizy</span>
        <span class="art__cap" style="--x: 14%; --y: 30%">Agenda online</span>
        <span class="art__cap" style="--x: 32%; --y: 70%">Clientes que voltam</span>
        <span class="art__cap" style="--x: 50%; --y: 24%">Financeiro simples</span>
        <span class="art__cap" style="--x: 68%; --y: 62%">Site do seu negócio</span>
      </div>
    </div>

    <div class="marquee" aria-hidden="true">
      {
        [0, 1].map(() => (
          <div class="marquee__track">
            {ticker.map((t) => (
              <>
                <span>{t}</span>
                <i />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- PARA QUEM -->
  <section class="screen forwho" aria-labelledby="forwho-title">
    <div class="forwho__field" aria-hidden="true">
      {
        floaters.map((f, i) => (
          <span
            class={`float float--${f.tone}`}
            style={`--x:${f.x}%;--y:${f.y}%;--r:${f.r}deg;--w:${f.w}px;--h:${f.h}px;--d:${(i % 5) * -1.4}s`}
          >
            {f.label && <b>{f.label}</b>}
          </span>
        ))
      }
    </div>
    <div class="forwho__center">
      <p class="eyebrow">A IKIZY é feita para</p>
      <h2 id="forwho-title" class="sr-only">Para quem é a IKIZY</h2>
      <ul class="sr-only">{crafts.map((c) => <li>{c.name}: {c.hint}</li>)}</ul>
      <div class="ticker" aria-hidden="true">
        {crafts.map((c, i) => <span style={`--i:${i}`}>{c.name}</span>)}
      </div>
      <p class="lead">De quem atende sozinha ao salão com equipe: agenda, clientes e caixa no mesmo lugar.</p>
      <a class="btn btn--primary" href={LINKS.signup}>Teste agora</a>
    </div>
  </section>

  <!-- DORES -->
  <section class="section screen container pains" aria-labelledby="pains-title">
    <div class="pains__head">
      <div aria-hidden="true">
        {chips.map((c) => <span class={`chip ${c.hot ? 'chip--hot' : ''}`} style={`--x:${c.x}%;--y:${c.y}%;--d:${c.d}s`}>{c.t}</span>)}
      </div>
      <h2 id="pains-title" class="pains__title">Do caderno ao <em>sistema</em></h2>
    </div>
    <div class="pains__cards">
      {
        pains.map((x) => (
          <article class="pain">
            <p class="pain__was">{x.was}</p>
            <h3>{x.title}</h3>
            <p>{x.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- POR QUE NÓS -->
  <section class="section screen container why" aria-labelledby="why-title">
    <div class="why__grid">
      <div class="why__rings" aria-hidden="true"><span></span><span></span><span></span></div>
      <h2 id="why-title" class="why__title">Por que<br />a <em>IKIZY</em>?</h2>
      {
        reasons.map((r, i) => (
          <article class={`why__card why__card--${i + 1}`}>
            <h3>{r.title}</h3>
            <span class="why__n">{r.n}</span>
            <p>{r.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- RECURSOS -->
  <section id="recursos" class="section screen container" aria-labelledby="res-title">
    <div class="section__head">
      <p class="eyebrow">Recursos</p>
      <h2 id="res-title" class="h2">Tudo o que o seu dia <em>precisa</em></h2>
    </div>

    <div class="cols">
      <article class="col" tabindex="0">
        <span class="col__n">01</span>
        <div class="col__visual" aria-hidden="true">
          <div class="slots">
            <span>09:00</span><span class="is-busy">10:00</span><span class="is-busy">11:30</span><span>13:00</span><span class="is-busy">14:30</span><span>16:00</span>
          </div>
        </div>
        <div>
          <h3>Agenda online</h3>
          <p>Visão por dia e por profissional, com confirmação e lembrete para a cliente.</p>
        </div>
      </article>

      <article class="col" tabindex="0">
        <span class="col__n">02</span>
        <div class="col__visual" aria-hidden="true">
          <div class="avatars"><span>JP</span><span>MC</span><span>PL</span><span>+48</span></div>
        </div>
        <div>
          <h3>Clientes que voltam</h3>
          <p>Ficha com histórico, preferências, alergias, cartão fidelidade e aviso de retorno atrasado.</p>
        </div>
      </article>

      <article class="col" tabindex="0">
        <span class="col__n">03</span>
        <div class="col__visual" aria-hidden="true">
          <div class="bars"><i style="--h: 38%"></i><i style="--h: 55%"></i><i style="--h: 46%"></i><i style="--h: 72%"></i><i style="--h: 64%"></i><i style="--h: 90%"></i></div>
        </div>
        <div>
          <h3>Financeiro</h3>
          <p>Entradas, saídas e comissões num lugar só. O fechamento do mês sai como um recibo.</p>
        </div>
      </article>

      <article class="col" tabindex="0">
        <span class="col__n">04</span>
        <div class="col__visual" aria-hidden="true">
          <span class="urlpill">seu-negocio.ikizy.com</span>
        </div>
        <div>
          <h3>Seu site</h3>
          <p>Uma página própria com serviços, preços e equipe que você escolhe mostrar, para receber agendamentos.</p>
        </div>
      </article>
    </div>

    <ul class="chips" aria-label="Outros recursos">
      {extras.map((x) => <li>{x}</li>)}
    </ul>
  </section>

  <!-- COMO COMEÇAR -->
  <section class="section screen container" aria-labelledby="steps-title">
    <div class="section__head">
      <p class="eyebrow">Como começar</p>
      <h2 id="steps-title" class="h2">Do cadastro ao primeiro <em>agendamento</em></h2>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- PREÇOS -->
  <section id="precos" class="section screen container" aria-labelledby="price-title">
    <div class="section__head">
      <p class="eyebrow">Planos</p>
      <h2 id="price-title" class="h2">Um plano para o <em>tamanho</em> do seu negócio</h2>
    </div>
    <div class="period">
      <p id="period-label" class="period__label">Se pagar com Pix, quantos meses adiantado?</p>
      <div class="seg" role="radiogroup" aria-labelledby="period-label" data-seg>
        {
          PIX_MONTHS.map((m) => (
            <button type="button" role="radio" aria-checked={m === 1 ? 'true' : 'false'} class={`seg__item ${m === 1 ? 'is-active' : ''}`} data-months={m}>
              {m === 1 ? '1 mês' : `${m} meses`}
              {PIX_DISCOUNT_PCT[m] > 0 && <small class="seg__off">{PIX_DISCOUNT_PCT[m]}% off</small>}
            </button>
          ))
        }
      </div>
      <p class="period__hint">O cartão renova todo mês. O Pix vale pelo período escolhido e não renova sozinho.</p>
    </div>

    <div class="plans" data-plans data-discount={JSON.stringify(PIX_DISCOUNT_PCT)}>
      {
        PLANS.map((p) => (
          <article class={`plan ${p.hot ? 'plan--hot' : ''}`} data-cents={p.cents}>
            {p.hot && <span class="plan__tag">Mais escolhido</span>}
            <h3>{p.name}</h3>
            <p class="plan__price"><small>R$</small><span data-total>{brlNumber(p.cents)}</span><small data-unit>/mês</small></p>
            <p class="plan__equiv" data-equiv>No Pix por 1 mês, ou cartão com renovação mensal</p>
            <ul class="plan__list">
              {p.items.map((it) => <li>{it}</li>)}
            </ul>
            <a class={`btn ${p.hot ? 'btn--light' : 'btn--primary'}`} href={LINKS.signup}>{p.cta}</a>
          </article>
        ))
      }
    </div>
    <p class="note">Pague no cartão, com renovação automática, ou no Pix, de 1, 3 ou 12 meses adiantado (12 meses com 5% de desconto).</p>
  </section>

  <!-- SOBRE -->
  <section id="sobre" class="section screen container" aria-labelledby="about-title">
    <div class="about">
      <div class="about__text">
        <p class="eyebrow">Sobre a IKIZY</p>
        <h2 id="about-title" class="h2">Gestão simples, para quem cuida da <em>beleza</em></h2>
        <p class="lead">
          A IKIZY nasceu para tirar o peso administrativo de quem vive de beleza: cabeleireiras, manicures, lash designers,
          designers de sobrancelha e donas de salão.
        </p>
        <p class="lead">
          Em vez de cadernos, planilhas e mensagens soltas, você tem um só lugar para a agenda, as clientes, o caixa e o site do
          seu negócio. Menos tempo organizando, mais tempo na sua arte.
        </p>
      </div>
      <ol class="steps about__values">
        {
          values.map((v, i) => (
            <li>
              <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section screen container" aria-labelledby="faq-title">
    <div class="faqs">
      <div class="faqs__side">
        <p class="eyebrow">Dúvidas</p>
        <h2 id="faq-title" class="h2">Perguntas <em>frequentes</em></h2>
        <p class="lead">Não encontrou o que procurava? Escreva para a gente, respondemos por e-mail.</p>
        <a class="btn btn--ghost" href="#contato">Falar com a IKIZY</a>
      </div>
      <div class="faqs__list">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <section id="contato" class="screen container" aria-labelledby="contact-title">
    <div class="statement">
      <p class="eyebrow">Contato</p>
      <h2 id="contact-title">Vamos <em>conversar</em>?</h2>
      <p>Dúvidas sobre o sistema, os planos ou como migrar do caderno e da planilha? Escreva para a gente.</p>
      <a class="statement__mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <div class="btn-row" style="justify-content: center; margin-top: 8px;">
        <a class="btn btn--light" href={LINKS.signup}>Teste agora</a>
        <a class="btn btn--outline-light" href={LINKS.login}>Já tenho conta</a>
      </div>
    </div>
  </section>
</Base>

<script is:inline id="halftone-script">
  (() => {
    const canvas = document.getElementById('halftone')
    if (!canvas) return
    const ctx = canvas.getContext('2d')
    const STEP = 9
    const INK = '14, 13, 12'
    const CUTS = [0.12, 0.3, 0.48, 0.66, 0.84]
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let visible = true
    let last = 0

    const smooth = (a, b, x) => {
      const t = Math.min(1, Math.max(0, (x - a) / (b - a)))
      return t * t * (3 - 2 * t)
    }

    function draw(t) {
      const dpr = Math.min(devicePixelRatio || 1, 2)
      const { width, height } = canvas.getBoundingClientRect()
      if (!width || !height) return
      const w = Math.round(width * dpr)
      const h = Math.round(height * dpr)
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w
        canvas.height = h
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.clearRect(0, 0, width, height)
      const cx = width / 2
      const cy = height / 2
      const R = Math.min(width * 0.46, height * 0.5)
      const cuts = CUTS.map((f) => f * width)
      ctx.fillStyle = 'rgb(' + INK + ')'
      for (let y = STEP / 2; y < height; y += STEP) {
        for (let x = STEP / 2; x < width; x += STEP) {
          const d = Math.hypot(x - cx, y - cy) / R
          if (d > 1) continue
          const ex = (x - cx) / (R * 0.5)
          const ey = (y - cy) / (R * 0.16)
          if (ex * ex + ey * ey < 1) continue
          let k = 0
          let gap = false
          for (const b of cuts) {
            if (x > b) k++
            if (Math.abs(x - b) < STEP * 0.45) gap = true
          }
          if (gap) continue
          const xs = x + k * 70
          const ys = y + k * 40
          const wave =
            Math.sin(xs * 0.012 + Math.sin(ys * 0.009 + t * 0.6) * 2.4 + t) +
            Math.sin(ys * 0.014 - xs * 0.007 + 1.7 - t * 0.8) * 0.8 +
            Math.sin((xs + ys) * 0.006 + Math.sin(xs * 0.01 - t * 0.5) * 1.6) * 0.6
          const v = (wave + 2.4) / 4.8
          const body = smooth(0, 0.35, 1 - d)
          const size = STEP * 0.6 * body * (0.3 + 0.7 * Math.pow(v, 1.3))
          if (size < 0.45) continue
          ctx.beginPath()
          ctx.arc(x, y, size, 0, Math.PI * 2)
          ctx.fill()
        }
      }
    }

    if (still) {
      draw(0)
      new ResizeObserver(() => draw(0)).observe(canvas)
      return
    }
    new IntersectionObserver((e) => (visible = e[0].isIntersecting)).observe(canvas)
    const tick = (now) => {
      if (visible && now - last >= 1000 / 30) {
        last = now
        draw(now / 4000)
      }
      requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)
  })()
</script>

<script is:inline id="pricing-script">
  (() => {
    const seg = document.querySelector("[data-seg]")
    const plans = document.querySelector("[data-plans]")
    if (!seg || !plans) return
    const discount = JSON.parse(plans.dataset.discount)
    const num = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    const brl = (c) => "R$ " + num.format(c / 100)

    function update(months) {
      const pct = discount[months] || 0
      plans.querySelectorAll("[data-cents]").forEach((plan) => {
        const cents = Number(plan.dataset.cents)
        const full = cents * months
        const total = Math.round((full * (100 - pct)) / 100)
        plan.querySelector("[data-total]").textContent = num.format(total / 100)
        plan.querySelector("[data-unit]").textContent = months === 1 ? "/mês" : "/" + months + " meses"
        const eq = plan.querySelector("[data-equiv]")
        eq.textContent = ""
        if (months === 1) {
          eq.textContent = "No Pix por 1 mês, ou cartão com renovação mensal"
          return
        }
        if (pct > 0) {
          const old = document.createElement("s")
          old.textContent = brl(full)
          eq.append(old, " ")
        }
        eq.append((pct > 0 ? "no" : "No") + " Pix, equivale a " + brl(total / months) + "/mês" + (pct > 0 ? " (" + pct + "% de desconto)" : ""))
      })
    }

    seg.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-months]")
      if (!btn) return
      seg.querySelectorAll("[data-months]").forEach((b) => {
        const on = b === btn
        b.classList.toggle("is-active", on)
        b.setAttribute("aria-checked", on ? "true" : "false")
      })
      update(Number(btn.dataset.months))
    })
  })()
</script>
