---
import Base from '../layouts/Base.astro'
import PixelBunny from '../components/PixelBunny.astro'
import PixelMorph from '../components/PixelMorph.astro'
import Perk from '../components/Perk.astro'
import PlanOption from '../components/PlanOption.astro'
import { APP_URL, CTA, LINKS } from '../lib/site'
import { PIX_DISCOUNT_PCT, PLANS, TRIAL_DAYS } from '../lib/pricing'

/** especialidades que passam sem parar abaixo do título do "Para quem é", com "você." a cada volta */
const crafts = ['lash designers', 'brow designers', 'cabeleireiras', 'nail designers', 'esteticistas', 'maquiadoras']

/** recursos reais do sistema em cartões de tamanhos diferentes; o "antes" vem da antiga seção "Do caderno ao sistema" e o financeiro é o cartão preto de destaque */
const features = [
  { was: 'Agenda no caderno', title: 'Agenda online', ui: 'agenda' },
  { was: 'Cliente que sumiu', title: 'Clientes que voltam', ui: 'client' },
  { was: 'Mensagem digitada uma a uma', title: 'Mensagens prontas', ui: 'message' },
  { was: 'Caixa e comissão na calculadora', title: 'Financeiro e comissões', ui: 'money' },
  { was: 'Horário marcado por direct', title: 'Site do seu negócio', ui: 'site' },
]

/** passo a passo com telas reais do sistema (modo demonstração, com dados de exemplo) */
const tour = [
  { img: '/telas/inicio.webp', title: 'Seu dia num relance', text: 'Ao entrar, você vê o faturamento, os próximos atendimentos e as mensagens do dia.' },
  { img: '/telas/agenda.webp', title: 'Marque e acompanhe horários', text: 'A agenda do dia por profissional, com o status de cada atendimento.' },
  { img: '/telas/clientes.webp', title: 'Conheça cada cliente', text: 'Histórico, preferências, alergias e quando ela deve voltar, tudo na ficha.' },
  { img: '/telas/financeiro.webp', title: 'Feche o mês sem planilha', text: 'Faturamento, comissões e lucro do mês, com o recibo pronto para conferir.' },
  { img: '/telas/site.webp', title: 'Receba pedidos pelo seu site', text: 'Personalize sua página e divulgue o link para as clientes pedirem horário.' },
]

const faq = [
  { q: 'Posso testar a IKIZY antes de assinar?', a: `Sim. Todo negócio novo tem ${TRIAL_DAYS} dias grátis, em qualquer plano, e dá para testar sem cadastrar cartão.` },
  { q: 'O que acontece quando acabam os 30 dias?', a: 'Seus dados continuam salvos e você pode consultá-los. Para voltar a editar, é só escolher um plano e continuar de onde parou, com agenda, clientes e financeiro intactos. Se você não cadastrou cartão, nada é cobrado automaticamente.' },
  { q: 'Funciona no celular? Minhas clientes precisam baixar algo?', a: 'Funciona direto no navegador do celular. Suas clientes não baixam nada: só abrem o link do seu site para pedir horário.' },
  { q: 'Posso cancelar minha assinatura quando quiser?', a: 'Sim. No cartão, você cancela quando quiser e o acesso continua até o fim do período já pago. No Pix não há renovação automática: o acesso vale pelo período que você pagou.' },
  { q: 'Meus dados ficam seguros na IKIZY?', a: 'Cada negócio enxerga apenas os próprios dados, e a equipe acessa por papéis: dona, gerente, recepção e profissional. Os pagamentos são feitos pela Stripe, e a IKIZY não guarda os dados do seu cartão.' },
  { q: 'Consigo incluir quantas pessoas na minha equipe?', a: 'O Solo é para quem atende sozinha. No Studio entram até 3 profissionais, cada uma com o próprio login para ver a agenda dela pelo celular. No Salão não há limite, e você ainda pode dar acesso para gerente e recepção.' },
]

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<Base
  title="IKIZY"
  description="Agenda online, clientes, financeiro e site próprio em um só sistema. Gestão simples para salões, nail designers, lash, sobrancelha e estética. 30 dias grátis."
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="hero2" aria-label="Apresentação">
    <div class="hero2__grid">
      <!-- texto à esquerda como numa capa: título grande, linha com legenda + descrição e o link embaixo -->
      <div class="hero2__text">
        <div class="hero2__body">
          <h1 class="display">
            <span class="display__main"><span>Gestão</span> <em>simples</em></span>
            <span class="sr-only">para negócios de beleza</span>
          </h1>
          <!-- linha de baixo do título: legenda curta à esquerda e a descrição ao lado -->
          <div class="hero2__row">
            <p class="hero2__label" aria-hidden="true">para negócios de beleza</p>
            <p class="hero2__note">
              Agenda, clientes, financeiro e o site do seu negócio em um só lugar. Menos tempo organizando, mais tempo atendendo.
            </p>
          </div>
        </div>
        <!-- no celular: botão largo de cadastro + link; no desktop só o link (o cadastro fica no ticket) -->
        <div class="hero2__actions">
          <a class="btn btn--primary hero2__signup" href={LINKS.signup}>{CTA.main}</a>
          <p class="hero2__hint">{CTA.hint}</p>
          <a class="btn btn--ghost" href="#como-funciona">Ver como funciona</a>
        </div>
      </div>

      <!-- ticket de cadastro (foto dos pincéis + convite) no canto inferior direito (só no desktop; no celular o cadastro é o botão largo) -->
      <aside class="ticket" aria-label="Teste grátis">
        <div class="ticket__stub" aria-hidden="true"><img src="/img/pinceis.avif" alt="" width="685" height="1034" decoding="async" /></div>
        <div class="ticket__body">
          <p class="ticket__meta">{CTA.hint}</p>
          <p class="ticket__title">Organize sua agenda hoje</p>
          <a class="btn btn--primary btn--sm" href={LINKS.signup}>{CTA.main}</a>
        </div>
      </aside>

      <div class="art" aria-hidden="true">
        <PixelMorph step={7} accent="#63001f" lift />
      </div>
    </div>
  </section>

  <!-- PARA QUEM É -->
  <section id="para-quem" class="section container you" aria-labelledby="you-title">
    <p class="eyebrow">Para quem é</p>
    <h2 id="you-title" class="you__title">
      A IKIZY é feita para
      <span class="you__line" aria-hidden="true">
        <span class="you__paren">*(</span>
        <span class="you__rot" data-you-rot>
          {crafts.map((c) => <span>{c}</span>)}
          <span class="is-in">você</span>
        </span>
        <span class="you__paren">)</span>
      </span>
      <span class="sr-only">você: {crafts.join(', ')}.</span>
    </h2>
    <p class="lead you__lead">
      Seu talento não precisa de burocracia. Os bastidores ficam com a gente para você focar no que faz de melhor.
    </p>
  </section>

  <!-- POR QUE TROCAR (recursos) -->
  <section id="recursos" class="section container feats" aria-labelledby="feats-title">
    <div class="section__head">
      <p class="eyebrow">Recursos</p>
      <h2 id="feats-title" class="h2">Por que trocar para a <em>IKIZY</em></h2>
      <p class="lead">Tudo o que você fazia no caderno, na calculadora e de cabeça, agora num lugar só.</p>
    </div>
    <ul class="feats__grid">
      {
        features.map((f) => (
          <li class={`feat feat--${f.ui}`}>
            <p class="feat__was"><span>Antes</span><s>{f.was}</s></p>
            <h3>{f.ui === 'money' ? <span>{f.title}</span> : f.title}</h3>
            <div class="feat__visual" aria-hidden="true">
              {f.ui === 'agenda' && (
                <div class="ui ui--phone">
                  <small>Hoje</small>
                  <span>09:00 · Escova</span>
                  <span class="is-busy">10:30 · Gel</span>
                  <span>14:30 · Cílios</span>
                </div>
              )}
              {f.ui === 'client' && (
                <div class="ui ui--client">
                  <span class="ui__avatar">AM</span>
                  <div><b>Ana Martins</b><small>Lash · manutenção</small></div>
                  <span class="ui__late">12 dias atrasada</span>
                </div>
              )}
              {f.ui === 'message' && (
                <div class="ui ui--bubble">
                  <p>Oi, Ana! Passando para lembrar do seu horário amanhã às 10:30.</p>
                  <small>Abrir no WhatsApp</small>
                </div>
              )}
              {f.ui === 'money' && (
                <div class="ui ui--money">
                  <span>Comissão · Bia</span>
                  <b>R$ 1.240,00</b>
                  <div class="ui__bars"><i style="--h: 40%" /><i style="--h: 62%" /><i style="--h: 48%" /><i style="--h: 80%" /><i style="--h: 66%" /></div>
                </div>
              )}
              {f.ui === 'site' && <span class="ui ui--url">seu-negocio.ikizy.com</span>}
            </div>
            {f.ui === 'money' && (
              <>
                <p class="feat__foot">Caixa, comissões e o fechamento do mês, sem calculadora</p>
                <a class="feat__go" href="#como-funciona" aria-label="Veja a IKIZY por dentro">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                </a>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- COMO FUNCIONA: etapas em pílulas à esquerda e as telas em círculos à direita (a da vez é a maior);
       no computador a seção fica presa e a rolagem passa de uma etapa para a outra -->
  <div class="tour-pin" data-tour-pin>
  <section id="como-funciona" class="section container tour" aria-labelledby="tour-title">
    <div class="section__head">
      <p class="eyebrow">Como começar</p>
      <h2 id="tour-title" class="h2">Veja a IKIZY <em>por dentro</em></h2>
    </div>
    <div class="tour__body">
      <ol class="tour__steps" aria-label="Etapas">
        {
          tour.map((t, i) => (
            <li>
              <button type="button" class="tour__step" data-tour-step={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="tour__dot" aria-hidden="true" />
                <span>{t.title}</span>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </button>
            </li>
          ))
        }
      </ol>
      <div class="tour__stage">
        <div class="tour__bar">
          <p class="tour__label">Telas do sistema</p>
          <div class="tour__nav">
            <span class="tour__count" aria-live="polite" data-tour-count>1 / {tour.length}</span>
            <div class="tour__pager">
              <button type="button" class="tour__arrow" aria-label="Etapa anterior" data-tour-prev disabled>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </button>
              <span class="tour__dots" aria-hidden="true">{tour.map((_, i) => <i class={i === 0 ? 'is-on' : ''} />)}</span>
              <button type="button" class="tour__arrow" aria-label="Próxima etapa" data-tour-next>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </button>
            </div>
          </div>
        </div>
        <ul class="tour__orbs" role="list" aria-label="Telas do sistema">
          {
            tour.map((t, i) => (
              <li class="tour__orb" data-d={Math.min(i, 4)} data-tour-orb={i}>
                <img src={t.img} alt={`Tela do sistema IKIZY: ${t.title.toLowerCase()}`} width="1600" height="1000" loading="eager" decoding="async" />
              </li>
            ))
          }
        </ul>
        <div class="tour__caps">
          {
            tour.map((t, i) => (
              <figure class={i === 0 ? 'tour__cap is-on' : 'tour__cap'}>
                <figcaption>
                  <span class="tour__n">{String(i + 1).padStart(2, '0')}</span>
                  <b>{t.title}</b>
                  <span>{t.text}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  </div>

  <!-- PLANOS -->
  <section id="precos" class="section container" aria-labelledby="price-title">
    <!-- planos: título curto e chave à esquerda; lista de escolha (como num app) e um botão só à direita -->
    <div class="pricing">
      <div class="pricing__head">
        <p class="eyebrow">Preços</p>
        <h2 id="price-title" class="pricing__title">Escolha <em>seu plano</em></h2>
        <div class="toggle" data-toggle>
          <button type="button" class="toggle__label is-active" tabindex="-1" data-period="1">Mensal</button>
          <button type="button" role="switch" aria-checked="false" aria-label="Ver preços do plano trimestral" class="toggle__switch" data-switch>
            <span aria-hidden="true"></span>
          </button>
          <button type="button" class="toggle__label" tabindex="-1" data-period="3">Trimestral</button>
        </div>
        <ul class="perks">
          <Perk>Agenda, clientes e financeiro num lugar só</Perk>
          <Perk>Site com agendamento online</Perk>
          <Perk>{TRIAL_DAYS} dias grátis, sem cartão</Perk>
        </ul>
      </div>

      <div class="plans" data-plans data-discount={PIX_DISCOUNT_PCT[3]}>
        <fieldset class="plans__list">
          <legend class="sr-only">Plano</legend>
          {PLANS.map((p) => <PlanOption plan={p} />)}
        </fieldset>
        <a class="btn btn--primary plans__cta" href={`${LINKS.signup}?plano=studio`} data-cta>Começar com o Studio</a>
        <p class="plans__note" data-note>No cartão renova sozinho todo mês, ou no Pix, mês a mês.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section container faq" aria-labelledby="faq-title">
    <div class="faqs">
      <div class="faqs__head">
        <p class="eyebrow">Dúvidas</p>
        <h2 id="faq-title" class="h2">Perguntas <em>frequentes</em></h2>
        <p class="lead">As dúvidas mais comuns de quem está chegando. Não achou a sua? <a href="#contato">Fale com a gente</a>.</p>
      </div>
      <div class="faqs__list">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTATO: faixa clara com um campo de e-mail só (vira lead e recebe a apresentação da IKIZY) e o coelho pixelado -->
  <section id="contato" class="section container" aria-labelledby="contact-title">
    <div class="contact">
      <div class="contact__text">
        <h2 id="contact-title" class="h2">Vamos construir uma <em>rotina melhor?</em></h2>
        <p class="lead">Deixe seu e-mail e a gente te mostra como a IKIZY deixa o dia a dia do seu negócio mais leve.</p>
        <form class="contact__form" action={`${APP_URL}/api/lead`} method="post" novalidate data-lead>
          <label class="sr-only" for="lead-email">Seu e-mail</label>
          <input id="lead-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="seu@email.com" required maxlength="254" />
          <input class="contact__trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="btn btn--primary">Quero conhecer</button>
        </form>
        <p class="contact__note" role="status" aria-live="polite" data-lead-note>Sem spam. Só um e-mail com tudo o que a IKIZY faz.</p>
        <p class="contact__login">Já tem conta? <a href={LINKS.login}>Entrar</a></p>
      </div>
      <div class="contact__art" aria-hidden="true"><PixelBunny /></div>
    </div>
  </section>
</Base>

<script is:inline id="pricing-script">
  // planos: escolher na lista troca o botão; o interruptor Mensal/Trimestral troca preços e o selo de economia
  (() => {
    const toggle = document.querySelector('[data-toggle]')
    const plans = document.querySelector('[data-plans]')
    if (!toggle || !plans) return
    const pct = Number(plans.dataset.discount)
    const num = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    const brl = (c) => 'R$ ' + num.format(c / 100)
    const cta = plans.querySelector('[data-cta]')
    const note = plans.querySelector('[data-note]')
    const signup = cta.getAttribute('href').split('?')[0]

    function select() {
      const checked = plans.querySelector('input:checked')
      const plan = checked.closest('[data-id]')
      cta.textContent = plan.dataset.ctaText
      cta.href = signup + '?plano=' + plan.dataset.id
    }
    plans.addEventListener('change', select)
    select()

    function render(months) {
      plans.querySelectorAll('[data-cents]').forEach((plan) => {
        const cents = Number(plan.dataset.cents)
        const full = cents * 3
        // mesmo cálculo da cobrança (pixAmountCents): arredonda o total do período para o centavo
        const total = Math.round((full * (100 - pct)) / 100)
        const save = plan.querySelector('[data-save]')
        plan.querySelector('[data-price]').textContent = brl(months === 1 ? cents : total)
        plan.querySelector('[data-unit]').textContent = months === 1 ? '/mês' : '/3 meses'
        save.textContent = 'Economize ' + brl(full - total)
        save.hidden = months === 1
      })
      note.textContent =
        months === 1
          ? 'No cartão renova sozinho todo mês, ou no Pix, mês a mês.'
          : 'Pago no Pix, de uma vez, pelos 3 meses, com ' + pct + '% de desconto. Não renova sozinho.'
    }

    const sw = toggle.querySelector('[data-switch]')
    let period = 1
    function setPeriod(months) {
      if (months === period) return
      period = months
      sw.setAttribute('aria-checked', months === 3 ? 'true' : 'false')
      toggle.querySelectorAll('[data-period]').forEach((b) => b.classList.toggle('is-active', Number(b.dataset.period) === months))
      plans.classList.add('is-swapping')
      setTimeout(() => {
        render(months)
        plans.classList.remove('is-swapping')
      }, 160)
    }
    // o interruptor alterna; as palavras "Mensal" e "Trimestral" escolhem direto
    sw.addEventListener('click', () => setPeriod(period === 1 ? 3 : 1))
    toggle.querySelectorAll('[data-period]').forEach((b) => b.addEventListener('click', () => setPeriod(Number(b.dataset.period))))
  })()
</script>

<script is:inline id="you-script">
  // "Para quem é": as profissões trocam sem parar abaixo do título, no lugar (some uma, aparece a outra);
  // "você." fica um pouco mais em cada volta.
  (() => {
    const rot = document.querySelector('[data-you-rot]')
    if (!rot) return
    const words = [...rot.children]
    const last = words.length - 1
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    let i = last
    let visible = false
    let timer = 0
    // os parênteses abraçam a palavra da vez: a largura acompanha cada troca
    const fit = () => (rot.style.width = words[i].offsetWidth + 'px')
    rot.classList.add('is-fit')
    addEventListener('resize', fit)
    fit()
    document.fonts.ready.then(fit)
    const step = () => {
      words[i].classList.remove('is-in')
      words[i].classList.add('is-out')
      const prev = words[i]
      setTimeout(() => prev.classList.remove('is-out'), 500)
      i = (i + 1) % words.length
      words[i].classList.add('is-in')
      fit()
      timer = setTimeout(tick, i === last ? 2600 : 1400)
    }
    const tick = () => (visible ? step() : (timer = setTimeout(tick, 400)))
    new IntersectionObserver((e) => (visible = e[0].isIntersecting), { threshold: 0.4 }).observe(rot)
    timer = setTimeout(tick, 1800)
  })()
</script>

<script is:inline id="tour-script">
  // "Veja a IKIZY por dentro": uma etapa por vez; pílulas, setas, círculos e teclado escolhem a etapa.
  // No computador a seção fica presa e cada trecho de rolagem passa para a próxima etapa.
  (() => {
    const root = document.querySelector('.tour')
    const pin = document.querySelector('[data-tour-pin]')
    if (!root || !pin) return
    const steps = [...root.querySelectorAll('[data-tour-step]')]
    const orbs = [...root.querySelectorAll('[data-tour-orb]')]
    const caps = [...root.querySelectorAll('.tour__cap')]
    const dots = [...root.querySelectorAll('.tour__dots i')]
    const prev = root.querySelector('[data-tour-prev]')
    const next = root.querySelector('[data-tour-next]')
    const count = root.querySelector('[data-tour-count]')
    const n = steps.length
    const wide = matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)')
    // um quarto de tela por etapa: a seção inteira segura só uma tela a mais de rolagem
    const stepPx = () => innerHeight * 0.25
    let active = 0
    const show = (i) => {
      active = i
      steps.forEach((s, k) => s.setAttribute('aria-pressed', String(k === i)))
      orbs.forEach((o, k) => (o.dataset.d = Math.min(4, Math.abs(k - i))))
      caps.forEach((c, k) => c.classList.toggle('is-on', k === i))
      dots.forEach((d, k) => d.classList.toggle('is-on', k === i))
      count.textContent = i + 1 + ' / ' + n
      prev.disabled = i === 0
      next.disabled = i === n - 1
    }
    const pinned = () => pin.classList.contains('is-pinned')
    const follow = () => {
      if (!pinned()) return
      const i = Math.max(0, Math.min(n - 1, Math.round(-pin.getBoundingClientRect().top / stepPx())))
      if (i !== active) show(i)
    }
    const layout = () => {
      pin.classList.toggle('is-pinned', wide.matches)
      pin.style.height = pinned() ? pin.firstElementChild.offsetHeight + stepPx() * (n - 1) + 'px' : ''
      follow()
    }
    const go = (i) => {
      i = Math.max(0, Math.min(n - 1, i))
      if (pinned()) scrollTo({ top: pin.getBoundingClientRect().top + scrollY + i * stepPx(), behavior: 'smooth' })
      else show(i)
    }
    steps.forEach((s, k) => s.addEventListener('click', () => go(k)))
    orbs.forEach((o, k) => o.addEventListener('click', () => go(k)))
    prev.addEventListener('click', () => go(active - 1))
    next.addEventListener('click', () => go(active + 1))
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') (e.preventDefault(), go(active - 1))
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') (e.preventDefault(), go(active + 1))
    })
    addEventListener('scroll', () => requestAnimationFrame(follow), { passive: true })
    addEventListener('resize', layout)
    wide.addEventListener('change', layout)
    addEventListener('load', layout)
    layout()
  })()
</script>

<script is:inline id="contact-script">
  // "Vamos construir uma rotina melhor?": manda o e-mail para o app (vira lead e recebe a apresentação da IKIZY)
  (() => {
    const form = document.querySelector('[data-lead]')
    if (!form) return
    const note = document.querySelector('[data-lead-note]')
    const input = form.querySelector('input[type="email"]')
    const button = form.querySelector('button')
    const say = (text, state) => {
      note.textContent = text
      note.dataset.state = state
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!input.checkValidity()) return (say('Confira o seu e-mail.', 'error'), input.focus())
      button.disabled = true
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: input.value, website: form.elements.website.value }),
        })
        if (!res.ok) {
          const body = await res.json().catch(() => null)
          throw new Error(body?.message || 'Não deu para enviar agora. Tente de novo em instantes.')
        }
        form.hidden = true
        say('Prontinho! Mandamos um e-mail para ' + input.value + '. Dá uma olhada na caixa de entrada.', 'ok')
      } catch (err) {
        say(err.message, 'error')
        button.disabled = false
      }
    })
  })()
</script>
