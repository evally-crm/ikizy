---
import Base from '../layouts/Base.astro'
import Field from '../components/Field.astro'
import PixelFlower from '../components/PixelFlower.astro'
import { CONTACT_EMAIL, CTA, LINKS } from '../lib/site'
import { PIX_DISCOUNT_PCT, PLANS, TRIAL_DAYS, brlNumber } from '../lib/pricing'

/** especialidades que passam sem parar abaixo do título do "Para quem é", com "você." a cada volta */
const crafts = ['lash designers', 'brow designers', 'cabeleireiros(as)', 'nail designers', 'esteticistas', 'maquiadoras']

/** recursos reais do sistema em cartões de tamanhos diferentes; o "antes" vem da antiga seção "Do caderno ao sistema" e o financeiro é o cartão preto de destaque */
const features = [
  { was: 'Agenda no caderno', title: 'Agenda online', ui: 'agenda' },
  { was: 'Cliente que sumiu', title: 'Clientes que voltam', ui: 'client' },
  { was: 'Mensagem digitada uma a uma', title: 'Mensagens prontas', ui: 'message' },
  { was: 'Caixa e comissão na calculadora', title: 'Financeiro e comissões', ui: 'money' },
  { was: 'Horário marcado por direct', title: 'Site do seu negócio', ui: 'site' },
]

/** passo a passo com telas reais do sistema (modo demonstração, com dados de exemplo) */
const tour = [
  { img: '/telas/inicio.webp', title: 'Seu dia num relance', text: 'Ao entrar, você vê o faturamento, os próximos atendimentos e as mensagens do dia.' },
  { img: '/telas/agenda.webp', title: 'Marque e acompanhe horários', text: 'A agenda do dia por profissional, com o status de cada atendimento.' },
  { img: '/telas/clientes.webp', title: 'Conheça cada cliente', text: 'Histórico, preferências, alergias e quando ela deve voltar, tudo na ficha.' },
  { img: '/telas/financeiro.webp', title: 'Feche o mês sem planilha', text: 'Faturamento, comissões e lucro do mês, com o recibo pronto para conferir.' },
  { img: '/telas/site.webp', title: 'Receba pedidos pelo seu site', text: 'Personalize sua página e divulgue o link para as clientes pedirem horário.' },
]

const faq = [
  { q: 'Posso testar a IKIZY antes de assinar?', a: `Sim. Todo negócio novo tem ${TRIAL_DAYS} dias grátis, em qualquer plano, e dá para testar sem cadastrar cartão.` },
  { q: 'Posso cancelar minha assinatura quando quiser?', a: 'Sim. No cartão, você cancela quando quiser e o acesso continua até o fim do período já pago. No Pix não há renovação automática: o acesso vale pelo período que você pagou.' },
  { q: 'Meus dados ficam seguros na IKIZY?', a: 'Cada negócio enxerga apenas os próprios dados, e a equipe acessa por papéis: dona, gerente, recepção e profissional. Os pagamentos são feitos pela Stripe, e a IKIZY não guarda os dados do seu cartão.' },
  { q: 'Consigo incluir quantas pessoas na minha equipe?', a: 'O Solo é para quem atende sozinha. Para trabalhar com equipe, escolha o Studio, pensado para equipes pequenas, ou o Salão, para equipes maiores.' },
]

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<Base
  title="IKIZY"
  description="Agenda online, clientes, financeiro e site próprio em um só sistema. Gestão simples para salões, nail designers, lash, sobrancelha e estética. 30 dias grátis."
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="hero2" aria-label="Apresentação">
    <div class="hero2__grid">
      <!-- texto à esquerda como numa capa: título grande, linha com legenda + descrição e o link embaixo -->
      <div class="hero2__text">
        <div class="hero2__body">
          <h1 class="display">
            <span class="display__main"><span>Gestão</span> <em>simples</em></span>
            <span class="sr-only">para negócios de beleza</span>
          </h1>
          <!-- linha de baixo do título: legenda curta à esquerda e a descrição ao lado -->
          <div class="hero2__row">
            <p class="hero2__label" aria-hidden="true">para negócios de beleza</p>
            <p class="hero2__note">
              Agenda, clientes, financeiro e o site do seu negócio em um só lugar. Menos tempo organizando, mais tempo atendendo.
            </p>
          </div>
        </div>
        <!-- no celular: botão largo de cadastro + link; no desktop só o link (o cadastro fica no ticket) -->
        <div class="hero2__actions">
          <a class="btn btn--primary hero2__signup" href={LINKS.signup}>{CTA.main}</a>
          <a class="btn btn--ghost" href="#como-funciona">Ver como funciona</a>
          <p class="hero2__hint">{CTA.hint}</p>
        </div>
      </div>

      <!-- ticket de cadastro (flor de pixels + convite) no canto inferior direito, perto da boca (só no desktop; no celular o cadastro é o botão largo) -->
      <aside class="ticket" aria-label="Teste grátis">
        <div class="ticket__stub" aria-hidden="true"><PixelFlower /></div>
        <div class="ticket__body">
          <p class="ticket__meta">{CTA.hint}</p>
          <p class="ticket__title">Organize seu salão</p>
          <a class="btn btn--primary btn--sm" href={LINKS.signup}>{CTA.main}</a>
        </div>
      </aside>

      <div class="art" aria-hidden="true">
        <canvas id="halftone"></canvas>
      </div>
    </div>
  </section>

  <!-- PARA QUEM É -->
  <section id="para-quem" class="section container you" aria-labelledby="you-title">
    <p class="eyebrow">Para quem é</p>
    <h2 id="you-title" class="you__title">
      A IKIZY é feita para
      <span class="you__line" aria-hidden="true">
        <span class="you__rot" data-you-rot>
          {crafts.map((c) => <span>{c}</span>)}
          <span class="is-in">você.</span>
        </span>
      </span>
      <span class="sr-only">você: {crafts.join(', ')}.</span>
    </h2>
    <p class="lead you__lead">
      Não importa se você trabalha com cabelos, unhas, cílios ou sobrancelhas. Se você atende clientes por conta própria ou gerencia uma
      equipe, a IKIZY ajuda a organizar sua rotina para que você possa cuidar de quem confia no seu trabalho.
    </p>
  </section>

  <!-- POR QUE TROCAR (recursos) -->
  <section id="recursos" class="section container feats" aria-labelledby="feats-title">
    <div class="section__head">
      <p class="eyebrow">Recursos</p>
      <h2 id="feats-title" class="h2">Por que trocar para a <em>IKIZY</em></h2>
      <p class="lead">Tudo o que você fazia no caderno, na calculadora e de cabeça, agora num lugar só.</p>
    </div>
    <ul class="feats__grid">
      {
        features.map((f) => (
          <li class={`feat feat--${f.ui}`}>
            <p class="feat__was"><span>Antes</span><s>{f.was}</s></p>
            <h3>{f.title}</h3>
            <div class="feat__visual" aria-hidden="true">
              {f.ui === 'agenda' && (
                <div class="ui ui--phone">
                  <small>Hoje</small>
                  <span>09:00 · Escova</span>
                  <span class="is-busy">10:30 · Gel</span>
                  <span>14:30 · Cílios</span>
                </div>
              )}
              {f.ui === 'client' && (
                <div class="ui ui--client">
                  <span class="ui__avatar">AM</span>
                  <div><b>Ana Martins</b><small>Lash · manutenção</small></div>
                  <span class="ui__late">12 dias atrasada</span>
                </div>
              )}
              {f.ui === 'message' && (
                <div class="ui ui--bubble">
                  <p>Oi, Ana! Passando para lembrar do seu horário amanhã às 10:30.</p>
                  <small>Abrir no WhatsApp</small>
                </div>
              )}
              {f.ui === 'money' && (
                <div class="ui ui--money">
                  <span>Comissão · Bia</span>
                  <b>R$ 1.240,00</b>
                  <div class="ui__bars"><i style="--h: 40%" /><i style="--h: 62%" /><i style="--h: 48%" /><i style="--h: 80%" /><i style="--h: 66%" /></div>
                </div>
              )}
              {f.ui === 'site' && <span class="ui ui--url">seu-negocio.ikizy.com</span>}
            </div>
            {f.ui === 'money' && (
              <a class="feat__plus" href="#como-funciona">
                <span class="feat__circle" aria-hidden="true">+</span>
                <span>Veja a IKIZY por dentro</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- COMO FUNCIONA (carrossel com telas reais) -->
  <section id="como-funciona" class="section container tour" aria-labelledby="tour-title">
    <div class="tour__head">
      <div class="section__head">
        <p class="eyebrow">Como começar</p>
        <h2 id="tour-title" class="h2">Veja a IKIZY <em>por dentro</em></h2>
      </div>
      <div class="tour__nav">
        <span class="tour__count" aria-live="polite" data-tour-count>1 / {tour.length}</span>
        <button type="button" class="tour__arrow" aria-label="Etapa anterior" data-tour-prev disabled>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        </button>
        <button type="button" class="tour__arrow" aria-label="Próxima etapa" data-tour-next>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        </button>
      </div>
    </div>
    <ol class="tour__track" aria-label="Etapas" data-tour-track tabindex="0">
      {
        tour.map((t, i) => (
          <li class="tour__slide" aria-label={`${i + 1} de ${tour.length}`}>
            <figure>
              <img src={t.img} alt={`Tela do sistema IKIZY: ${t.title.toLowerCase()}`} width="1600" height="1000" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              <figcaption>
                <span class="tour__n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{t.title}</h3>
                <p>{t.text}</p>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- PLANOS -->
  <section id="precos" class="section container" aria-labelledby="price-title">
    <div class="pricing">
      <div class="pricing__head">
        <p class="eyebrow">Planos</p>
        <h2 id="price-title" class="h2">Um plano para o <em>tamanho</em> do seu negócio</h2>
        <p class="lead">Todos os planos começam com {TRIAL_DAYS} dias grátis.</p>
        <div class="toggle" data-toggle>
          <button type="button" class="toggle__label is-active" tabindex="-1" data-period="1">Mensal</button>
          <button type="button" role="switch" aria-checked="false" aria-label="Ver preços do plano trimestral" class="toggle__switch" data-switch>
            <span aria-hidden="true"></span>
          </button>
          <button type="button" class="toggle__label" tabindex="-1" data-period="3">Trimestral</button>
          <span class="toggle__off">Economize {PIX_DISCOUNT_PCT[3]}%</span>
        </div>
      </div>

      <div class="plans" data-plans data-discount={PIX_DISCOUNT_PCT[3]}>
        {
          PLANS.map((p, i) => {
            // o 1º item é o público do plano; "Tudo do X" vira o título da lista
            const [audience, ...rest] = p.items
            const base = rest.find((it) => it.startsWith('Tudo do'))
            const list = rest.filter((it) => it !== base)
            const [int, dec] = brlNumber(p.cents).split(',')
            return (
              <article class={`plan ${p.hot ? 'plan--hot' : ''}`} data-cents={p.cents}>
                <div class="plan__top">
                  <span class="plan__icon" aria-hidden="true">
                    {Array.from({ length: i + 1 }, () => <i />)}
                  </span>
                  {p.hot && <span class="plan__tag">Mais escolhido</span>}
                </div>
                <div>
                  <h3>{p.name}</h3>
                  <p class="plan__aud">{audience}</p>
                </div>
                <div class="plan__swap">
                  <p class="plan__price">
                    <small>R$</small>
                    <span><span data-int>{int}</span><span class="plan__dec" data-dec>,{dec}</span></span>
                    <small data-unit>/mês</small>
                  </p>
                  <p class="plan__equiv" data-equiv>Cobrança mensal: no cartão, renova sozinha todo mês, ou no Pix, mês a mês.</p>
                  <span class="plan__save" data-save hidden />
                </div>
                <div class="plan__inc">
                  <p class="plan__inc-title">{base ? `${base}, mais:` : 'O que está incluído:'}</p>
                  <ul class="plan__list">
                    {list.map((it) => <li>{it}</li>)}
                  </ul>
                </div>
                <a class="btn btn--primary" href={`${LINKS.signup}?plano=${p.id}`}>{p.cta}</a>
              </article>
            )
          })
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section container" aria-labelledby="faq-title">
    <div class="faqs">
      <div class="faqs__side">
        <p class="eyebrow">Dúvidas</p>
        <h2 id="faq-title" class="h2">Perguntas <em>frequentes</em></h2>
        <a class="btn btn--ghost" href="#contato">Falar com a IKIZY</a>
      </div>
      <div class="faqs__list">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <section id="contato" class="section container contact" aria-labelledby="contact-title">
    <form class="contact__form" action={`mailto:${CONTACT_EMAIL}`} method="post" enctype="text/plain" data-contact>
      <Field label="Nome" name="nome" autocomplete="name" required />
      <Field label="E-mail" name="email" type="email" autocomplete="email" required />
      <Field label="Mensagem" name="mensagem" multiline required />
      <button type="submit" class="btn btn--primary">Enviar mensagem</button>
      <p class="contact__note" role="status" data-contact-note hidden>
        Abrimos seu e-mail com a mensagem pronta. Se nada abriu, escreva para <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </form>
    <div class="contact__text">
      <p class="eyebrow">Contato</p>
      <h2 id="contact-title" class="h2">Vamos construir uma <em>rotina melhor?</em></h2>
      <p class="lead">Quer conhecer a IKIZY, tirar dúvidas ou conversar sobre o seu negócio? Escreva para a gente.</p>
      <a class="contact__mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <p class="contact__login">Já tem conta? <a href={LINKS.login}>Entrar</a></p>
    </div>
  </section>
</Base>

<script is:inline id="halftone-script">
  // boca preta em símbolos (ponto, +, x, quadrado), aberta e com bordas esfumadas, se mexendo
  (() => {
    const canvas = document.getElementById('halftone')
    if (!canvas) return
    const ctx = canvas.getContext('2d')
    const INK = 'rgb(14, 13, 12)'
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let visible = true
    let last = 0

    const smooth = (a, b, x) => {
      const k = Math.min(1, Math.max(0, (x - a) / (b - a)))
      return k * k * (3 - 2 * k)
    }
    const bell = (x, w) => Math.exp(-((x / w) ** 2))
    const hash = (c, r) => {
      const s = Math.sin(c * 12.9898 + r * 78.233) * 43758.5453
      return s - Math.floor(s)
    }
    const waveAt = (x, y, t) =>
      (Math.sin(x * 0.012 + Math.sin(y * 0.009 + t * 0.6) * 2.4 + t) + Math.sin(y * 0.014 - x * 0.007 + 1.7 - t * 0.8) * 0.8 + 1.8) / 3.6

    // contornos arredondados em u ∈ [-1, 1]: oval com um leve arco do cupido, e a abertura no meio onde fica a marca
    const top = (u) => -0.56 * Math.pow(1 - u * u, 0.6) + 0.11 * bell(u, 0.14)
    const bottom = (u) => 0.58 * Math.pow(1 - u * u, 0.55)
    const OPEN_W = 0.52
    const opening = (u, t) => Math.sqrt(Math.max(0, 1 - (u / OPEN_W) ** 2)) * (1 + Math.sin(t * 0.7) * 0.06)

    /** densidade (0..1) da boca: cheia no meio dos lábios, esfumando perto da borda e da abertura */
    function density(u, v, t) {
      if (Math.abs(u) >= 1) return 0
      const o = opening(u, t)
      const ui = -0.12 * o
      const li = 0.14 * o
      const tp = top(u)
      const bt = bottom(u)
      if (v < tp - 0.14 || v > bt + 0.14) return 0
      if (v > ui && v < li) return 0
      // distância (em u) até a borda mais próxima: de fora ou da abertura
      const out = Math.min(v - tp, bt - v)
      const inner = v <= ui ? ui - v : v - li
      const lipLine = Math.abs(v) < 0.03 && o === 0 ? 0.35 : 0 // fenda entre os lábios perto dos cantos
      return Math.max(0, smooth(-0.08, 0.26, out) * smooth(-0.01, 0.14, inner) - lipLine)
    }

    /** símbolo conforme a densidade, como no login: nada · ponto · + · x · quadradinho · quadrado */
    function glyph(x, y, cell, d, mix) {
      const m = cell / 2
      const a = cell * 0.3
      if (d < 0.1) return
      if (d >= 0.56 && mix < 0.3) d = 0.5
      if (d < 0.24) return ctx.fillRect(x + m - 0.9, y + m - 0.9, 1.8, 1.8)
      ctx.beginPath()
      if (d < 0.4) {
        ctx.moveTo(x + m, y + m - a)
        ctx.lineTo(x + m, y + m + a)
        ctx.moveTo(x + m - a, y + m)
        ctx.lineTo(x + m + a, y + m)
        return ctx.stroke()
      }
      if (d < 0.56) {
        ctx.moveTo(x + m - a * 0.9, y + m - a * 0.9)
        ctx.lineTo(x + m + a * 0.9, y + m + a * 0.9)
        ctx.moveTo(x + m + a * 0.9, y + m - a * 0.9)
        ctx.lineTo(x + m - a * 0.9, y + m + a * 0.9)
        return ctx.stroke()
      }
      if (d < 0.72) return ctx.fillRect(x + m - a, y + m - a, a * 2, a * 2)
      ctx.fillRect(x + 1, y + 1, cell - 2, cell - 2)
    }

    function draw(t) {
      const dpr = Math.min(devicePixelRatio || 1, 2)
      const { width, height } = canvas.getBoundingClientRect()
      if (!width || !height) return
      const w = Math.round(width * dpr)
      const h = Math.round(height * dpr)
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w
        canvas.height = h
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.clearRect(0, 0, width, height)

      const S = Math.min(width * 0.46, height * 0.66)
      const STEP = 7
      const cx = width / 2
      const cy = height / 2

      ctx.lineWidth = 1.3
      ctx.fillStyle = ctx.strokeStyle = INK
      for (let row = 0, y = STEP / 2; y < height; row++, y += STEP) {
        for (let col = 0, x = STEP / 2; x < width; col++, x += STEP) {
          const u = (x - cx) / S + Math.sin(y * 0.02 + t * 0.8) * 0.01
          const v = (y - cy) / S + Math.sin(x * 0.017 - t * 0.6) * 0.01
          const n = hash(row, col)
          const wave = waveAt(x, y, t)
          let d = density(u, v, t)
          if (d <= 0.02) {
            // pontinhos e + soltos em volta, como pó
            const e = Math.hypot(u / 1.12, v / 0.78)
            const inMouth = Math.abs(u) < OPEN_W + 0.06 && Math.abs(v) < 0.2
            if (!inMouth && e < 1.2 && n < smooth(1.2, 0.85, e) * 0.45 * wave) d = 0.15 + n * 0.4
            else continue
          } else {
            // volume dos lábios: mais escuro junto à abertura, brilho no lábio de baixo, e ondas que fazem os símbolos irem e voltarem
            const gloss = bell(u - 0.12, 0.25) * bell(v - 0.36, 0.08) * 0.45
            const rim = bell(Math.abs(v) - 0.16, 0.06) * 0.2
            d = d * (0.84 + 0.16 * wave) + rim - gloss
          }
          glyph(x - STEP / 2, y - STEP / 2, STEP, d + (n - 0.5) * 0.14, hash(col, row))
        }
      }
    }

    if (still) {
      draw(0)
      new ResizeObserver(() => draw(0)).observe(canvas)
      return
    }
    new IntersectionObserver((e) => (visible = e[0].isIntersecting)).observe(canvas)
    const tick = (now) => {
      if (visible && now - last >= 1000 / 30) {
        last = now
        draw(now / 1000)
      }
      requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)
  })()
</script>

<script is:inline id="pricing-script">
  // interruptor Mensal/Trimestral: troca preço, textos e o destaque de economia de cada plano, com um fade curto
  (() => {
    const toggle = document.querySelector('[data-toggle]')
    const plans = document.querySelector('[data-plans]')
    if (!toggle || !plans) return
    const pct = Number(plans.dataset.discount)
    const num = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    const brl = (c) => 'R$ ' + num.format(c / 100)
    // preço grande: inteiro em preto e os centavos em cinza
    const setPrice = (plan, c) => {
      const [int, dec] = num.format(c / 100).split(',')
      plan.querySelector('[data-int]').textContent = int
      plan.querySelector('[data-dec]').textContent = ',' + dec
    }

    function render(months) {
      plans.querySelectorAll('[data-cents]').forEach((plan) => {
        const cents = Number(plan.dataset.cents)
        const full = cents * 3
        // mesmo cálculo da cobrança (pixAmountCents): arredonda o total do período para o centavo
        const total = Math.round((full * (100 - pct)) / 100)
        const save = plan.querySelector('[data-save]')
        const eq = plan.querySelector('[data-equiv]')
        if (months === 1) {
          setPrice(plan, cents)
          plan.querySelector('[data-unit]').textContent = '/mês'
          eq.textContent = 'Cobrança mensal: no cartão, renova sozinha todo mês, ou no Pix, mês a mês.'
          save.hidden = true
          return
        }
        setPrice(plan, total)
        plan.querySelector('[data-unit]').textContent = '/3 meses'
        eq.textContent = ''
        const old = document.createElement('s')
        old.textContent = brl(full)
        eq.append(old, ' Equivale a ' + brl(Math.round(total / 3)) + '/mês. Pago no Pix, de uma vez, pelos 3 meses; não renova sozinho.')
        save.textContent = 'Economize ' + brl(full - total)
        save.hidden = false
      })
    }

    const sw = toggle.querySelector('[data-switch]')
    let period = 1
    function setPeriod(months) {
      if (months === period) return
      period = months
      sw.setAttribute('aria-checked', months === 3 ? 'true' : 'false')
      toggle.querySelectorAll('[data-period]').forEach((b) => b.classList.toggle('is-active', Number(b.dataset.period) === months))
      plans.classList.toggle('is-quarterly', months === 3)
      plans.classList.add('is-swapping')
      setTimeout(() => {
        render(months)
        plans.classList.remove('is-swapping')
      }, 160)
    }
    // o interruptor alterna; as palavras "Mensal" e "Trimestral" escolhem direto
    sw.addEventListener('click', () => setPeriod(period === 1 ? 3 : 1))
    toggle.querySelectorAll('[data-period]').forEach((b) => b.addEventListener('click', () => setPeriod(Number(b.dataset.period))))
  })()
</script>

<script is:inline id="you-script">
  // "Para quem é": as profissões trocam sem parar abaixo do título, no lugar (some uma, aparece a outra);
  // "você." fica um pouco mais em cada volta.
  (() => {
    const rot = document.querySelector('[data-you-rot]')
    if (!rot) return
    const words = [...rot.children]
    const last = words.length - 1
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    let i = last
    let visible = false
    let timer = 0
    const step = () => {
      words[i].classList.remove('is-in')
      words[i].classList.add('is-out')
      const prev = words[i]
      setTimeout(() => prev.classList.remove('is-out'), 500)
      i = (i + 1) % words.length
      words[i].classList.add('is-in')
      timer = setTimeout(tick, i === last ? 2600 : 1400)
    }
    const tick = () => (visible ? step() : (timer = setTimeout(tick, 400)))
    new IntersectionObserver((e) => (visible = e[0].isIntersecting), { threshold: 0.4 }).observe(rot)
    timer = setTimeout(tick, 1800)
  })()
</script>

<script is:inline id="tour-script">
  // carrossel do "Como começar": setas avançam e voltam uma etapa; também rola no dedo ou no trackpad
  (() => {
    const track = document.querySelector('[data-tour-track]')
    if (!track) return
    const prev = document.querySelector('[data-tour-prev]')
    const next = document.querySelector('[data-tour-next]')
    const count = document.querySelector('[data-tour-count]')
    const slides = [...track.children]
    // etapa mais próxima da borda esquerda, pela posição real de cada card (conta o espaço entre eles)
    const start = (el) => el.offsetLeft - slides[0].offsetLeft
    const current = () =>
      slides.reduce((best, el, k) => (Math.abs(start(el) - track.scrollLeft) < Math.abs(start(slides[best]) - track.scrollLeft) ? k : best), 0)
    const go = (i) => {
      const target = slides[Math.max(0, Math.min(slides.length - 1, i))]
      track.scrollTo({ left: start(target), behavior: 'smooth' })
    }
    const sync = () => {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4
      count.textContent = (atEnd ? slides.length : current() + 1) + ' / ' + slides.length
      prev.disabled = track.scrollLeft < 4
      next.disabled = atEnd
    }
    prev.addEventListener('click', () => go(current() - 1))
    next.addEventListener('click', () => go(current() + 1))
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true })
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') (e.preventDefault(), go(current() - 1))
      if (e.key === 'ArrowRight') (e.preventDefault(), go(current() + 1))
    })
    addEventListener('resize', sync)
    sync()
  })()
</script>

<script is:inline id="contact-script">
  // o formulário abre o e-mail da pessoa já preenchido (não há envio pelo servidor)
  (() => {
    const form = document.querySelector('[data-contact]')
    if (!form) return
    form.addEventListener('submit', (e) => {
      e.preventDefault()
      const d = new FormData(form)
      const to = form.getAttribute('action').replace('mailto:', '')
      const subject = 'Contato pelo site · ' + d.get('nome')
      const body = d.get('mensagem') + '\n\n' + d.get('nome') + '\n' + d.get('email')
      location.href = 'mailto:' + to + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body)
      form.querySelector('[data-contact-note]').hidden = false
    })
  })()
</script>
