---
import Base from '../layouts/Base.astro'
import { CONTACT_EMAIL, CTA, LINKS } from '../lib/site'
import { PIX_DISCOUNT_PCT, PIX_MONTHS, PLANS, brlNumber } from '../lib/pricing'

const crafts = [
  { name: 'Cabeleireira', hint: 'Agenda por profissional' },
  { name: 'Nail Designer', hint: 'Serviços e custo por produto' },
  { name: 'Lash Design', hint: 'Retorno e manutenção' },
  { name: 'Sobrancelha', hint: 'Retorno e lembretes' },
]

const ticker = ['Agenda online', 'Clientes que voltam', 'Financeiro descomplicado', 'Site do seu negócio', 'Comissões da equipe', 'Lembretes por WhatsApp', 'Relatórios']

const pains = [
  { was: 'Cliente esqueceu o horário', title: 'Lembrete automático', text: 'Confirmação por WhatsApp antes do horário.' },
  { was: 'Caixa no caderno', title: 'Financeiro em um lugar', text: 'Entradas, saídas e fechamento do mês.' },
  { was: 'Cliente que sumiu', title: 'Aviso de retorno', text: 'Veja quem está atrasada para voltar.' },
  { was: 'Comissão na calculadora', title: 'Comissão por profissional', text: 'Calculada sozinha, sem planilha.' },
]

const reasons = [
  { tag: 'Simples', title: 'Pronto em minutos', text: 'Sem curso e sem manual.', ui: 'setup' },
  { tag: 'Feito para beleza', title: 'Pensado para beleza', text: 'Aviso de quem está atrasada para o retorno.', ui: 'client' },
  { tag: 'No celular', title: 'Sua agenda no bolso', text: 'No navegador, sem instalar nada.', ui: 'agenda' },
  { tag: 'Segurança', title: 'Cada um vê o que deve', text: 'Acesso por papel para toda a equipe.', ui: 'roles' },
]

const steps = [
  { title: 'Crie sua conta', text: 'Leva poucos minutos.' },
  { title: 'Cadastre serviços e equipe', text: 'O sistema sugere o básico do seu segmento.' },
  { title: 'Agende e acompanhe', text: 'Divulgue seu site e acompanhe tudo.' },
]

const faq = [
  { q: 'O que é a IKIZY?', a: 'A IKIZY é um sistema de gestão online para salões e negócios de beleza. Reúne agenda, cadastro de clientes, financeiro, equipe e um site próprio para receber agendamentos.' },
  { q: 'Para quem a IKIZY é indicada?', a: 'Para cabeleireiras, nail designers, profissionais de cílios e sobrancelhas, studios e salões, de quem atende sozinha a quem tem equipe.' },
  { q: 'Preciso instalar alguma coisa?', a: 'Não. A IKIZY funciona direto no navegador, no computador ou no celular.' },
  { q: 'Posso testar antes de assinar?', a: 'Sim. O plano Solo tem 1 mês grátis, sem pedir cartão. Crie sua conta e use o sistema durante o teste antes de decidir.' },
  { q: 'Como posso pagar?', a: 'No cartão de crédito, com renovação automática todo mês, ou no Pix, pagando 1, 3 ou 12 meses adiantado, sendo que 12 meses têm 5% de desconto. O Pix não renova sozinho: avisamos antes de o período acabar.' },
  { q: 'O que acontece quando o teste ou o período pago termina?', a: 'O sistema fica só para leitura: seus dados continuam salvos e você pode consultá-los. Ao escolher um plano, tudo volta a funcionar.' },
  { q: 'Meus dados ficam separados dos de outros negócios?', a: 'Sim. Cada negócio enxerga apenas os próprios dados, e o acesso da equipe é controlado por papéis: dona, gerente, recepção e profissional.' },
]

const extras = ['Equipe e comissões', 'Serviços e custos', 'Relatórios', 'Lembretes por WhatsApp', 'Acesso por papel']

const values = [
  { title: 'Estética', text: 'Ferramentas à altura de quem trabalha com beleza.' },
  { title: 'Elegância', text: 'Telas limpas, sem excesso.' },
  { title: 'Autenticidade', text: 'Seu negócio com identidade própria.' },
]

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<Base
  title="IKIZY"
  description="Agenda online, clientes, financeiro e site próprio em um só sistema. Gestão simples para salões, nail designers, lash e sobrancelha. Teste grátis por 1 mês."
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="hero2" aria-label="Apresentação">
    <div class="hero2__grid">
      <div class="hero2__text">
        <h1 class="display">
          <span class="display__main"><span>Gestão</span><i class="display__line" aria-hidden="true"></i><em>simples</em></span>
          <span class="display__sub">para negócios de beleza</span>
        </h1>
        <p class="hero2__note">
          Agenda, clientes e caixa em um só lugar.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={LINKS.signup}>{CTA.main}</a>
          <a class="btn btn--ghost" href="#recursos">Ver recursos</a>
        </div>
        <p class="hero2__hint">{CTA.hint}</p>
      </div>

      <div class="art" aria-hidden="true">
        <canvas id="halftone"></canvas>
        <span class="art__mark">ikizy</span>
        <span class="art__cap" style="--x: 14%; --y: 30%">Agenda online</span>
        <span class="art__cap" style="--x: 32%; --y: 70%">Clientes que voltam</span>
        <span class="art__cap" style="--x: 50%; --y: 24%">Financeiro simples</span>
        <span class="art__cap" style="--x: 68%; --y: 62%">Site do seu negócio</span>
      </div>
    </div>

    <div class="marquee" aria-hidden="true">
      {
        [0, 1].map(() => (
          <div class="marquee__track">
            {ticker.map((t) => (
              <>
                <span>{t}</span>
                <i />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- PARA QUEM -->
  <section class="section screen container forwho" aria-labelledby="forwho-title">
    <header class="forwho__head">
      <p class="eyebrow">Para quem é</p>
      <h2 id="forwho-title" class="forwho__title">A IKIZY é feita <em>para você</em></h2>
    </header>

    <div class="forwho__stage">
      <div class="forwho__circle" aria-hidden="true">
        <span class="forwho__time">Hoje, 14:30</span>
        <div class="ticker">
          {crafts.map((c, i) => <span style={`--i:${i}`}>{c.name}</span>)}
        </div>
      </div>
      <ol class="forwho__list">
        {
          crafts.map((c, i) => (
            <li class={`craft craft--${i + 1}`}>
              <div class="craft__top">
                <strong>{c.name}</strong>
                <span class="craft__n">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <p>{c.hint}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="forwho__foot">
      <p class="lead">Sozinha ou com equipe.</p>
      <a class="btn btn--primary" href={LINKS.signup}>{CTA.main}</a>
    </div>
  </section>

  <!-- DORES -->
  <section class="section screen container pains" aria-labelledby="pains-title">
    <header class="pains__head">
      <p class="eyebrow">Antes e depois</p>
      <h2 id="pains-title" class="pains__title">Do caderno ao <em>sistema</em></h2>
    </header>
    <ol class="pains__list">
      {
        pains.map((x, i) => (
          <li class="pain">
            <span class="pain__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="pain__body">
              <p class="pain__was">
                <span>Antes</span>
                <s>{x.was}</s>
              </p>
              <h3>{x.title}</h3>
              <p class="pain__text">{x.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- POR QUE NÓS -->
  <section class="section screen container why" aria-labelledby="why-title">
    <h2 id="why-title" class="why__title">Por que trocar para a <em>IKIZY</em></h2>
    <div class="why__list">
      {
        reasons.map((r) => (
          <article class="why__card">
            <div class="why__text">
              <p class="why__tag">{r.tag}</p>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </div>
            <div class="why__visual" aria-hidden="true">
              {r.ui === 'setup' && (
                <ul class="ui ui--list">
                  <li><span>Serviços</span><i class="ui__ok" /></li>
                  <li><span>Equipe</span><i class="ui__ok" /></li>
                  <li><span>Horários</span><i class="ui__ok" /></li>
                </ul>
              )}
              {r.ui === 'client' && (
                <div class="ui ui--client">
                  <span class="ui__avatar">AM</span>
                  <div><b>Ana Martins</b><small>Lash · manutenção</small></div>
                  <span class="ui__late">12 dias atrasada</span>
                </div>
              )}
              {r.ui === 'agenda' && (
                <div class="ui ui--phone">
                  <small>Hoje</small>
                  <span>09:00 · Escova</span>
                  <span class="is-busy">10:30 · Gel</span>
                  <span>14:30 · Cílios</span>
                </div>
              )}
              {r.ui === 'roles' && (
                <ul class="ui ui--list">
                  <li><span>Dona</span><i class="ui__sw is-on" /></li>
                  <li><span>Gerente</span><i class="ui__sw is-on" /></li>
                  <li><span>Recepção</span><i class="ui__sw" /></li>
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- RECURSOS -->
  <section id="recursos" class="section screen container" aria-labelledby="res-title">
    <div class="section__head">
      <p class="eyebrow">Recursos</p>
      <h2 id="res-title" class="h2">Tudo o que o seu dia <em>precisa</em></h2>
    </div>

    <div class="cols">
      <article class="col" tabindex="0">
        <span class="col__n">01</span>
        <div class="col__visual" aria-hidden="true">
          <div class="slots">
            <span>09:00</span><span class="is-busy">10:00</span><span class="is-busy">11:30</span><span>13:00</span><span class="is-busy">14:30</span><span>16:00</span>
          </div>
        </div>
        <div>
          <h3>Agenda online</h3>
          <p>Por dia e por profissional, com lembrete.</p>
        </div>
      </article>

      <article class="col" tabindex="0">
        <span class="col__n">02</span>
        <div class="col__visual" aria-hidden="true">
          <div class="avatars"><span>JP</span><span>MC</span><span>PL</span><span>+48</span></div>
        </div>
        <div>
          <h3>Clientes que voltam</h3>
          <p>Histórico, preferências e aviso de retorno.</p>
        </div>
      </article>

      <article class="col" tabindex="0">
        <span class="col__n">03</span>
        <div class="col__visual" aria-hidden="true">
          <div class="bars"><i style="--h: 38%"></i><i style="--h: 55%"></i><i style="--h: 46%"></i><i style="--h: 72%"></i><i style="--h: 64%"></i><i style="--h: 90%"></i></div>
        </div>
        <div>
          <h3>Financeiro</h3>
          <p>Entradas, saídas e comissões num lugar só.</p>
        </div>
      </article>

      <article class="col" tabindex="0">
        <span class="col__n">04</span>
        <div class="col__visual" aria-hidden="true">
          <span class="urlpill">seu-negocio.ikizy.com</span>
        </div>
        <div>
          <h3>Seu site</h3>
          <p>Sua página para receber agendamentos.</p>
        </div>
      </article>
    </div>

    <ul class="chips" aria-label="Outros recursos">
      {extras.map((x) => <li>{x}</li>)}
    </ul>
  </section>

  <!-- COMO COMEÇAR -->
  <section class="section screen container" aria-labelledby="steps-title">
    <div class="section__head">
      <p class="eyebrow">Como começar</p>
      <h2 id="steps-title" class="h2">Do cadastro ao primeiro <em>agendamento</em></h2>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- PREÇOS -->
  <section id="precos" class="section screen container" aria-labelledby="price-title">
    <div class="section__head">
      <p class="eyebrow">Planos</p>
      <h2 id="price-title" class="h2">Um plano para o <em>tamanho</em> do seu negócio</h2>
    </div>
    <div class="period">
      <p id="period-label" class="period__label">Se pagar com Pix, quantos meses adiantado?</p>
      <div class="seg" role="radiogroup" aria-labelledby="period-label" data-seg>
        {
          PIX_MONTHS.map((m) => (
            <button type="button" role="radio" aria-checked={m === 1 ? 'true' : 'false'} class={`seg__item ${m === 1 ? 'is-active' : ''}`} data-months={m}>
              {m === 1 ? '1 mês' : `${m} meses`}
              {PIX_DISCOUNT_PCT[m] > 0 && <small class="seg__off">{PIX_DISCOUNT_PCT[m]}% off</small>}
            </button>
          ))
        }
      </div>
      <p class="period__hint">Cartão renova todo mês. Pix não renova sozinho.</p>
    </div>

    <div class="plans" data-plans data-discount={JSON.stringify(PIX_DISCOUNT_PCT)}>
      {
        PLANS.map((p) => (
          <article class={`plan ${p.hot ? 'plan--hot' : ''}`} data-cents={p.cents}>
            {p.hot && <span class="plan__tag">Mais escolhido</span>}
            <h3>{p.name}</h3>
            <p class="plan__price"><small>R$</small><span data-total>{brlNumber(p.cents)}</span><small data-unit>/mês</small></p>
            <p class="plan__equiv" data-equiv>No Pix por 1 mês, ou cartão com renovação mensal</p>
            <ul class="plan__list">
              {p.items.map((it) => <li>{it}</li>)}
            </ul>
            <a class={`btn ${p.hot ? 'btn--light' : 'btn--primary'}`} href={LINKS.signup}>{p.cta}</a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- SOBRE -->
  <section id="sobre" class="section screen container" aria-labelledby="about-title">
    <div class="about">
      <div class="about__text">
        <p class="eyebrow">Sobre a IKIZY</p>
        <h2 id="about-title" class="h2">Gestão simples, para quem cuida da <em>beleza</em></h2>
        <p class="lead">Menos caderno e planilha, mais tempo na sua arte.</p>
      </div>
      <ol class="steps about__values">
        {
          values.map((v, i) => (
            <li>
              <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section screen container" aria-labelledby="faq-title">
    <div class="faqs">
      <div class="faqs__side">
        <p class="eyebrow">Dúvidas</p>
        <h2 id="faq-title" class="h2">Perguntas <em>frequentes</em></h2>
        <p class="lead">Não achou? Fale com a gente.</p>
        <a class="btn btn--ghost" href="#contato">Falar com a IKIZY</a>
      </div>
      <div class="faqs__list">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <section id="contato" class="screen container" aria-labelledby="contact-title">
    <div class="statement">
      <p class="eyebrow">Contato</p>
      <h2 id="contact-title">Vamos <em>conversar</em>?</h2>
      <p>Dúvidas sobre o sistema ou os planos? Escreva para a gente.</p>
      <a class="statement__mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <div class="btn-row" style="justify-content: center; margin-top: 8px;">
        <a class="btn btn--light" href={LINKS.signup}>{CTA.main}</a>
        <a class="btn btn--outline-light" href={LINKS.login}>Já tenho conta</a>
      </div>
    </div>
  </section>
</Base>

<script is:inline id="halftone-script">
  // boca preta em símbolos (ponto, +, x, quadrado), aberta e com bordas esfumadas, se mexendo
  (() => {
    const canvas = document.getElementById('halftone')
    if (!canvas) return
    const ctx = canvas.getContext('2d')
    const INK = 'rgb(14, 13, 12)'
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    let visible = true
    let last = 0

    const smooth = (a, b, x) => {
      const k = Math.min(1, Math.max(0, (x - a) / (b - a)))
      return k * k * (3 - 2 * k)
    }
    const bell = (x, w) => Math.exp(-((x / w) ** 2))
    const hash = (c, r) => {
      const s = Math.sin(c * 12.9898 + r * 78.233) * 43758.5453
      return s - Math.floor(s)
    }
    const waveAt = (x, y, t) =>
      (Math.sin(x * 0.012 + Math.sin(y * 0.009 + t * 0.6) * 2.4 + t) + Math.sin(y * 0.014 - x * 0.007 + 1.7 - t * 0.8) * 0.8 + 1.8) / 3.6

    // contornos arredondados em u ∈ [-1, 1]: oval com um leve arco do cupido, e a abertura no meio onde fica a marca
    const top = (u) => -0.56 * Math.pow(1 - u * u, 0.6) + 0.16 * bell(u, 0.13)
    const bottom = (u) => 0.58 * Math.pow(1 - u * u, 0.55)
    const OPEN_W = 0.52
    const opening = (u, t) => Math.sqrt(Math.max(0, 1 - (u / OPEN_W) ** 2)) * (1 + Math.sin(t * 0.7) * 0.06)

    /** densidade (0..1) da boca: cheia no meio dos lábios, esfumando perto da borda e da abertura */
    function density(u, v, t) {
      if (Math.abs(u) >= 1) return 0
      const o = opening(u, t)
      const ui = -0.12 * o
      const li = 0.14 * o
      const tp = top(u)
      const bt = bottom(u)
      if (v < tp - 0.14 || v > bt + 0.14) return 0
      if (v > ui && v < li) return 0
      // distância (em u) até a borda mais próxima: de fora ou da abertura
      const out = Math.min(v - tp, bt - v)
      const inner = v <= ui ? ui - v : v - li
      const lipLine = Math.abs(v) < 0.03 && o === 0 ? 0.35 : 0 // fenda entre os lábios perto dos cantos
      return Math.max(0, smooth(-0.03, 0.22, out) * smooth(-0.01, 0.14, inner) - lipLine)
    }

    /** símbolo conforme a densidade, como no login: nada · ponto · + · x · quadradinho · quadrado */
    function glyph(x, y, cell, d, mix) {
      const m = cell / 2
      const a = cell * 0.3
      if (d < 0.1) return
      if (d >= 0.56 && mix < 0.3) d = 0.5
      if (d < 0.24) return ctx.fillRect(x + m - 0.9, y + m - 0.9, 1.8, 1.8)
      ctx.beginPath()
      if (d < 0.4) {
        ctx.moveTo(x + m, y + m - a)
        ctx.lineTo(x + m, y + m + a)
        ctx.moveTo(x + m - a, y + m)
        ctx.lineTo(x + m + a, y + m)
        return ctx.stroke()
      }
      if (d < 0.56) {
        ctx.moveTo(x + m - a * 0.9, y + m - a * 0.9)
        ctx.lineTo(x + m + a * 0.9, y + m + a * 0.9)
        ctx.moveTo(x + m + a * 0.9, y + m - a * 0.9)
        ctx.lineTo(x + m - a * 0.9, y + m + a * 0.9)
        return ctx.stroke()
      }
      if (d < 0.72) return ctx.fillRect(x + m - a, y + m - a, a * 2, a * 2)
      ctx.fillRect(x + 1, y + 1, cell - 2, cell - 2)
    }

    function draw(t) {
      const dpr = Math.min(devicePixelRatio || 1, 2)
      const { width, height } = canvas.getBoundingClientRect()
      if (!width || !height) return
      const w = Math.round(width * dpr)
      const h = Math.round(height * dpr)
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w
        canvas.height = h
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.clearRect(0, 0, width, height)

      const S = Math.min(width * 0.46, height * 0.66)
      const STEP = 7
      const cx = width / 2
      const cy = height / 2

      ctx.lineWidth = 1.3
      ctx.fillStyle = ctx.strokeStyle = INK
      for (let row = 0, y = STEP / 2; y < height; row++, y += STEP) {
        for (let col = 0, x = STEP / 2; x < width; col++, x += STEP) {
          const u = (x - cx) / S + Math.sin(y * 0.02 + t * 0.8) * 0.01
          const v = (y - cy) / S + Math.sin(x * 0.017 - t * 0.6) * 0.01
          const n = hash(row, col)
          const wave = waveAt(x, y, t)
          let d = density(u, v, t)
          if (d <= 0.02) {
            // pontinhos e + soltos em volta, como pó
            const e = Math.hypot(u / 1.12, v / 0.78)
            const inMouth = Math.abs(u) < OPEN_W + 0.06 && Math.abs(v) < 0.2
            if (!inMouth && e < 1.2 && n < smooth(1.2, 0.85, e) * 0.22 * wave) d = 0.15 + n * 0.4
            else continue
          } else {
            // volume dos lábios: mais escuro junto à abertura, brilho no lábio de baixo, e ondas que fazem os símbolos irem e voltarem
            const gloss = bell(u - 0.12, 0.25) * bell(v - 0.36, 0.08) * 0.45
            const rim = bell(Math.abs(v) - 0.16, 0.06) * 0.2
            d = d * (0.84 + 0.16 * wave) + rim - gloss
          }
          glyph(x - STEP / 2, y - STEP / 2, STEP, d + (n - 0.5) * 0.14, hash(col, row))
        }
      }
    }

    if (still) {
      draw(0)
      new ResizeObserver(() => draw(0)).observe(canvas)
      return
    }
    new IntersectionObserver((e) => (visible = e[0].isIntersecting)).observe(canvas)
    const tick = (now) => {
      if (visible && now - last >= 1000 / 30) {
        last = now
        draw(now / 1000)
      }
      requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)
  })()
</script>

<script is:inline id="pricing-script">
  (() => {
    const seg = document.querySelector("[data-seg]")
    const plans = document.querySelector("[data-plans]")
    if (!seg || !plans) return
    const discount = JSON.parse(plans.dataset.discount)
    const num = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    const brl = (c) => "R$ " + num.format(c / 100)

    function update(months) {
      const pct = discount[months] || 0
      plans.querySelectorAll("[data-cents]").forEach((plan) => {
        const cents = Number(plan.dataset.cents)
        const full = cents * months
        const total = Math.round((full * (100 - pct)) / 100)
        plan.querySelector("[data-total]").textContent = num.format(total / 100)
        plan.querySelector("[data-unit]").textContent = months === 1 ? "/mês" : "/" + months + " meses"
        const eq = plan.querySelector("[data-equiv]")
        eq.textContent = ""
        if (months === 1) {
          eq.textContent = "No Pix por 1 mês, ou cartão com renovação mensal"
          return
        }
        if (pct > 0) {
          const old = document.createElement("s")
          old.textContent = brl(full)
          eq.append(old, " ")
        }
        eq.append((pct > 0 ? "no" : "No") + " Pix, equivale a " + brl(total / months) + "/mês" + (pct > 0 ? " (" + pct + "% de desconto)" : ""))
      })
    }

    seg.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-months]")
      if (!btn) return
      seg.querySelectorAll("[data-months]").forEach((b) => {
        const on = b === btn
        b.classList.toggle("is-active", on)
        b.setAttribute("aria-checked", on ? "true" : "false")
      })
      update(Number(btn.dataset.months))
    })
  })()
</script>
