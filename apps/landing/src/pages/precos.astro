---
import Base from '../layouts/Base.astro'
import { LINKS } from '../lib/site'

// Valores ainda não definidos: troque "XX" pelos preços reais antes de publicar.
const plans = [
  {
    name: 'Solo',
    price: 'XX',
    hot: false,
    items: ['Para quem atende sozinha', 'Agenda e clientes', 'Financeiro básico', 'Site do negócio'],
  },
  {
    name: 'Studio',
    price: 'XX',
    hot: true,
    items: ['Equipe pequena', 'Tudo do Solo', 'Comissões por profissional', 'Fechamento mensal em recibo', 'Relatórios'],
  },
  {
    name: 'Salão',
    price: 'XX',
    hot: false,
    items: ['Equipe maior', 'Tudo do Studio', 'Mais profissionais e permissões', 'Atendimento prioritário'],
  },
]

const faq = [
  { q: 'Preciso instalar alguma coisa?', a: 'Não. A IKIZY funciona no navegador, no computador ou no celular.' },
  { q: 'Posso testar antes de assinar?', a: 'Sim. Crie sua conta e explore o sistema.' },
  { q: 'Meus dados ficam separados dos de outros negócios?', a: 'Sim. Cada negócio enxerga apenas os próprios dados, e o acesso da equipe é controlado por papéis.' },
]
---

<Base title="Preços" description="Planos da IKIZY para quem atende sozinha, tem uma equipe pequena ou um salão completo.">
  <section class="container page-head">
    <p class="eyebrow">Planos</p>
    <h1 class="h1" style="margin-top: 10px;">Um plano para o <em>tamanho</em> do seu negócio.</h1>
    <p class="lead">Comece pequeno e cresça sem trocar de sistema.</p>
  </section>

  <section class="container">
    <div class="plans">
      {
        plans.map((p) => (
          <article class={`plan ${p.hot ? 'plan--hot' : ''}`}>
            {p.hot && <span class="plan__tag">Mais escolhido</span>}
            <h3>{p.name}</h3>
            <p class="plan__price"><small>R$</small>{p.price}<small>/mês</small></p>
            <ul class="plan__list">
              {p.items.map((it) => <li>{it}</li>)}
            </ul>
            <a class={`btn ${p.hot ? 'btn--light' : 'btn--primary'}`} href={LINKS.signup}>Teste agora</a>
          </article>
        ))
      }
    </div>
    <p class="note">Valores em definição. Fale com a gente para saber das condições de lançamento.</p>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h2" style="margin-bottom: 28px;">Dúvidas <em>frequentes</em></h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
