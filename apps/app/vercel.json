{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "routes": [
    { "src": "/", "has": [{ "type": "host", "value": "(?!app\\.|www\\.)(?<slug>[a-z0-9-]+)\\.ikizy\\.com" }], "dest": "/api/site?slug=$slug" },
    { "src": "/s/([a-z0-9-]+)", "dest": "/api/site?slug=$1" },
    { "handle": "filesystem" },
    { "src": "/(?!api/).*", "dest": "/index.html" }
  ]
}
