{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "(?!app\\.|www\\.)(?<slug>[a-z0-9-]+)\\.ikizy\\.com"
        }
      ],
      "dest": "/api/site?slug=$slug"
    },
    {
      "src": "/s/([a-z0-9-]+)",
      "dest": "/api/site?slug=$1"
    },
    {
      "src": "/api/cron/([a-z-]+)",
      "dest": "/api/cron?job=$1"
    },
    {
      "src": "/api/billing/([a-z-]+)",
      "dest": "/api/billing?action=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api/).*",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-requests",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/reconcile-stripe",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/cleanup-photos",
      "schedule": "0 7 * * *"
    }
  ]
}
