# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Use SOMENTE a chave "anon"/"publishable".
# Nunca coloque a chave "service_role" aqui: variáveis VITE_* vão para o navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
