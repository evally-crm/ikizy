# Copie para .env.local. Valores: `neon env pull` traz NEON_AUTH_BASE_URL e NEON_DATA_API_URL;
# copie-os para as variáveis VITE_* abaixo (elas vão para o navegador, não coloque segredos aqui).
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# ---- Cobrança (Stripe) · SÓ NO SERVIDOR ------------------------------------------------------
# Estas variáveis NÃO levam o prefixo VITE_ e nunca vão para o navegador. Configure-as em
# Vercel > ikizy-app > Settings > Environment Variables (use chaves de TESTE em Preview).
# STRIPE_SECRET_KEY=sk_test_...             chave secreta do Stripe
# STRIPE_WEBHOOK_SECRET=whsec_...           segredo do endpoint /api/stripe/webhook
# STRIPE_PORTAL_CONFIGURATION=bpc_...       (opcional) criado por `npm run stripe:setup`
# DATABASE_URL=postgres://...               conexão de DONO do banco Neon (o webhook grava em subscriptions)
# NEON_AUTH_BASE_URL=https://...            mesma URL do Neon Auth (confere o login de quem pede o checkout)
# APP_URL=https://app.ikizy.com             para onde o Stripe devolve a pessoa depois de pagar

# ---- Tarefas automáticas e proteção do agendamento · SÓ NO SERVIDOR ----------------------------
# CRON_SECRET=...                           a Vercel manda no cabeçalho dos crons (expire-requests, trial-reminders, reconcile-stripe)
# TURNSTILE_SITE_KEY=0x...                  (opcional) chave pública do Cloudflare Turnstile, vai para a página do site
# TURNSTILE_SECRET_KEY=0x...                (opcional) segredo do Turnstile; sem ele o agendamento não pede verificação

# ---- E-mails, fotos e monitoramento · SÓ NO SERVIDOR (exceto VITE_SENTRY_DSN) -------------------
# RESEND_API_KEY=…            e-mails (código, avisos, novo pedido, boas-vindas)
# BLOB_READ_WRITE_TOKEN=…     loja de fotos "ikizy-fotos"; na Vercel vem sozinha ao ligar a loja ao projeto
# SENTRY_DSN=…                erros das funções do servidor; sem ela, só o log da Vercel
# VITE_SENTRY_DSN=…           erros no navegador (pode ser a mesma do SENTRY_DSN); precisa de um novo deploy
