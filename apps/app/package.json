{
  "name": "@ikizy/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:api": "tsx --test api/_lib/*.test.ts",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:domain": "tsx --test \"src/domain/**/*.test.ts\"",
    "test": "npm run test:api && npm run test:domain",
    "check:conventions": "node scripts/check-conventions.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/node": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.5",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
